@model Inventar.Storefront.ViewModels.Cart.CartPageViewModel
@{
    ViewData["Title"] = "Korpa";
}

<section class="page-head">
    <span class="eyebrow">Korpa</span>
</section>

@if (Model.Lines.Count == 0)
{
    <div class="empty-state">
        <h3>Korpa je trenutno prazna.</h3>
        <p>Krenite od kataloga i sačuvajte nekoliko modela za uži izbor.</p>
        <a class="button" asp-controller="Catalog" asp-action="Index">Pogledaj proizvode</a>
    </div>
}
else
{
    <section class="cart-layout" data-cart-page>
        <div class="cart-lines">
            <div class="flash flash--error cart-feedback" data-cart-feedback hidden></div>

            @foreach (var line in Model.Lines)
            {
                <article class="cart-line" data-cart-line data-line-id="@line.LineId">
                    @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                    {
                        <img class="cart-line__image" src="@line.ImageUrl" alt="@line.Name" />
                    }
                    else
                    {
                        <div class="product-card__placeholder cart-line__image">Bez fotografije</div>
                    }

                    <div class="cart-line__content">
                        <h2>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-slug="@line.Slug">@line.ShortDescription</a>
                        </h2>
                        <p>
                            @if (!string.IsNullOrWhiteSpace(line.SizeLabel))
                            {
                                <span>@line.SizeLabel</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.Color))
                            {
                                <span> - @line.Color</span>
                            }
                        </p>
                        <p class="cart-line__price">@line.UnitPrice.ToString("0.00") € po kom.</p>

                        <div class="cart-line__actions">
                            <form asp-controller="Cart"
                                  asp-action="Update"
                                  method="post"
                                  class="cart-line__quantity-form"
                                  data-cart-line-form
                                  data-product-id="@line.ProductId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <input type="hidden" name="lineId" value="@line.LineId" />

                                <div class="cart-line__quantity-stepper">
                                    <button type="button"
                                            class="cart-line__quantity-button"
                                            data-cart-decrement
                                            aria-label="Smanji količinu">
                                        -
                                    </button>

                                    <input type="number"
                                           name="quantity"
                                           min="1"
                                           max="@line.MaxOrderQuantity"
                                           value="@line.Quantity"
                                           inputmode="numeric"
                                           data-cart-quantity-input />

                                    <button type="button"
                                            class="cart-line__quantity-button"
                                            data-cart-increment
                                            aria-label="Povećaj kolicinu">
                                        +
                                    </button>
                                </div>
                            </form>

                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lineId" value="@line.LineId" />
                                <button type="submit" class="button button--ghost">Ukloni</button>
                            </form>
                        </div>
                    </div>

                    <div class="cart-line__total" data-cart-line-total>@line.LineTotal.ToString("0.00") €</div>
                </article>
            }
        </div>

        <aside class="summary-card">
            <span class="eyebrow">Sažetak</span>
            <div class="summary-card__row">
                <span>Ukupno artikala</span>
                <strong data-cart-total-items>@Model.TotalItems</strong>
            </div>
            <div class="summary-card__row">
                <span>Iznos</span>
                <strong data-cart-subtotal>@Model.Subtotal.ToString("0.00") €</strong>
            </div>

            @if (Model.HasAvailabilityIssues)
            {
                <p class="flash flash--error">Prije nastavka korigujte količine koje prelaze trenutno dostupno stanje.</p>
            }

            <a class="button button--full" asp-controller="Checkout" asp-action="Index">Nastavi na narudžbinu</a>
        </aside>
    </section>
}
