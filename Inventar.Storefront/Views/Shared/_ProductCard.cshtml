@model Inventar.Storefront.ViewModels.Catalog.ProductCardViewModel
@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<article class="product-card">
    <a class="product-card__image-link" asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug">
        @if (Model.ShowSoldOutOverlay)
        {
            <span class="product-image-overlay product-image-overlay--card">
                @Inventar.Storefront.Services.StorefrontStockRules.SoldOutOverlayText
            </span>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img class="product-card__image" src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
        }
        else
        {
            <div class="product-card__placeholder">Bez fotografije</div>
        }
    </a>

    <div class="product-card__body">
        <p class="product-card__description">@Model.Description</p>

        <div class="product-card__footer">
            <div class="price-block">
                <span class="price-block__current">@Model.CurrentPrice.ToString("0.00") €</span>
                @if (Model.CompareAtPrice.HasValue)
                {
                    <span class="price-block__old">@Model.CompareAtPrice.Value.ToString("0.00") €</span>
                }
            </div>

            @if (Model.HasSelectableOptions)
            {
                <a class="button button--secondary product-card__cta product-card__cta--options"
                   asp-controller="Catalog"
                   asp-action="Details"
                   asp-route-slug="@Model.Slug">
                    Izaberite opcije
                </a>
            }
            else if (Model.CanAddToCart)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="product-card__cta-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.DirectAddProductId" />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="button product-card__cta product-card__cta--add">
                        Dodaj u korpu
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="button product-card__cta product-card__cta--sold-out" disabled>
                    @Inventar.Storefront.Services.StorefrontStockRules.SoldOutStatusText
                </button>
            }
        </div>
    </div>
</article>
