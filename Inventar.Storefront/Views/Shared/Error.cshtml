@model ErrorViewModel
@{
    ViewData["Title"] = "Greska";
}

<section class="page-head">
    <p class="page-head__eyebrow">Doslo je do greske</p>
    <h1>Trenutno nijesmo uspjeli da obradimo vas zahtjev.</h1>
    <p>Pokusajte ponovo za nekoliko trenutaka. Ako se problem ponavlja, vratite se na pocetnu stranicu i pokusajte ponovo odatle.</p>
</section>

@if (Model.ShowRequestId)
{
    <p class="flash flash--error">
        Referentni ID zahtjeva: <code>@Model.RequestId</code>
    </p>
}

<p>
    <a class="button button--secondary" asp-controller="Home" asp-action="Index">Povratak na pocetnu</a>
</p>
