@using Inventar.ViewModels.Inventory
@model EditTepihViewModel
@{
    ViewData["Title"] = "Edit";
    var isSlugReadOnly = User.IsInRole("admin") && !User.IsInRole("superadmin");
}

<h1>@Inventar.Resources.Resource.EditProduct</h1>

@if (TempData["StorefrontSuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["StorefrontErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}

<hr />

<div class="row g-4">
    <div class="col-12">
        <form asp-action="Edit" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Disabled" />
            <input type="hidden" asp-for="QRCodeUrl" />
            <input type="hidden" asp-for="DateTime" />

            <div class="col-sm-3">
                <label asp-for="ProductNumber" class="control-label">@Inventar.Resources.Resource.ProductNumber</label>
                <input asp-for="ProductNumber" class="form-control" readonly />
                <span asp-validation-for="ProductNumber" class="text-danger"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="Name" class="control-label">@Inventar.Resources.Resource.Name</label>
                <input asp-for="Name" class="form-control" readonly />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-sm-3">
                <label asp-for="Model" class="control-label">Model</label>
                <input asp-for="Model" class="form-control" readonly />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="col-sm-4">
                <label asp-for="BroaderCategory" class="control-label">@Inventar.Resources.Resource.BroaderCategory</label>
                <input asp-for="BroaderCategory" class="form-control" />
                <span asp-validation-for="BroaderCategory" class="text-danger"></span>
            </div>

            <div class="col-sm-4">
                <label asp-for="NarrowerCategory" class="control-label">@Inventar.Resources.Resource.NarrowerCategory</label>
                <input asp-for="NarrowerCategory" class="form-control" />
                <span asp-validation-for="NarrowerCategory" class="text-danger"></span>
            </div>

            <div class="col-sm-4">
                <label asp-for="UnID" class="control-label">UnID</label>
                <input asp-for="UnID" class="form-control" readonly />
            </div>

            <div class="col-sm-4">
                <label asp-for="DateTime" class="control-label">@Inventar.Resources.Resource.DateTime</label>
                <input asp-for="DateTime" class="form-control" readonly />
                <span asp-validation-for="DateTime" class="text-danger"></span>
            </div>

            <div class="col-sm-4">
                <label asp-for="QRCodeUrl" class="control-label">QR Code Url</label>
                <input asp-for="QRCodeUrl" class="form-control" readonly />
            </div>

            <div class="col-sm-4">
                <label asp-for="Slug" class="control-label">Slug</label>
                <input asp-for="Slug" class="form-control" disabled="@isSlugReadOnly" />
                @if (isSlugReadOnly)
                {
                    <input type="hidden" asp-for="Slug" />
                }
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="col-sm-3">
                <label asp-for="Color" class="control-label">@Inventar.Resources.Resource.Color</label>
                <input asp-for="Color" class="form-control" readonly />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="col-sm-2">
                <label asp-for="Quantity" class="control-label">@Inventar.Resources.Resource.Quantity</label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="col-sm-2">
                <label asp-for="ReservedQuantity" class="control-label">@Inventar.Resources.Resource.Reserved</label>
                <input asp-for="ReservedQuantity" class="form-control" readonly />
            </div>

            <div class="col-sm-2">
                <label asp-for="AvailableQuantity" class="control-label">@Inventar.Resources.Resource.Available</label>
                <input asp-for="AvailableQuantity" class="form-control" readonly />
            </div>

            <div class="col-sm-1">
                <label asp-for="PerM2" class="control-label">@Inventar.Resources.Resource.PerM2</label>
                <div class="checkbox-field">
                    @if (Model.PoMjeri)
                    {
                        <input type="checkbox" checked="@Model.PerM2" disabled />
                        <input type="hidden" asp-for="PerM2" />
                    }
                    else
                    {
                        <input asp-for="PerM2" />
                    }
                </div>
            </div>

            <div class="col-sm-2">
                <label asp-for="PoMjeri" class="control-label">Po mjeri</label>
                <div class="checkbox-field">
                    <input asp-for="PoMjeri" disabled />
                </div>
            </div>

            <div class="col-sm-4">
                <label asp-for="Width" class="control-label">@Inventar.Resources.Resource.Width</label>
                <input asp-for="Width" step="any" class="form-control" readonly />
                <span asp-validation-for="Width" class="text-danger"></span>
            </div>

            <div class="col-sm-4">
                <label asp-for="Length" class="control-label">@Inventar.Resources.Resource.Length</label>
                <input asp-for="Length" step="any" class="form-control" readonly />
                <span asp-validation-for="Length" class="text-danger"></span>
            </div>

            <div class="col-sm-4">
                <label asp-for="RemainingSize" class="control-label">Remaining size</label>
                <input asp-for="RemainingSize" class="form-control" readonly />
            </div>


            <div class="col-sm-3">
                <label asp-for="Price" class="control-label">@Inventar.Resources.Resource.Price</label>
                <input asp-for="Price" step="0.01" class="form-control" value="@Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="col-sm-3">
                <label asp-for="OnlinePrice" class="control-label">@Inventar.Resources.Resource.OnlinePrice</label>
                <input asp-for="OnlinePrice" step="0.01" class="form-control" value="@(Model.OnlinePrice.HasValue ? Model.OnlinePrice.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" />
                <span asp-validation-for="OnlinePrice" class="text-danger"></span>
            </div>

            <div class="col-sm-3">
                <label asp-for="IsPublished" class="control-label">@Inventar.Resources.Resource.Published</label>
                <div class="checkbox-field">
                    <input asp-for="IsPublished" />
                </div>
            </div>

            <div class="col-sm-3">
                <label class="control-label">@Inventar.Resources.Resource.eCommerceReady</label>
                <input class="form-control" readonly value="@(Model.IsPublished ? "Yes" : "No")" />
            </div>

            <div class="col-sm-6">
                <label asp-for="Description" class="control-label">@Inventar.Resources.Resource.Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="ShortDescription" class="control-label">@Inventar.Resources.Resource.ShortDescription</label>
                <textarea asp-for="ShortDescription" class="form-control"></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="form-check storefront-reuse-check">
                    <input asp-for="CopyDescriptionsToGroup" class="form-check-input" />
                    <label asp-for="CopyDescriptionsToGroup" class="form-check-label">
                        @Inventar.Resources.Resource.CopyDescAndShortDesc
                    </label>
@*                     <small class="text-muted d-block">
                        Use this when all variants in the group should share the same storefront text.
                    </small> *@
                </div>
            </div>

            @if (Model.PoMjeri)
            {
                <div class="col-12">
                    <div class="form-check storefront-reuse-check">
                        <input asp-for="CopyDescriptionsToIdenticalPoMjeri" class="form-check-input" />
                        <label asp-for="CopyDescriptionsToIdenticalPoMjeri" class="form-check-label">
                            @Inventar.Resources.Resource.CopyDescriptionAndShortDescriptionToIdenticalPoMjeriProducts
                        </label>
                    </div>
                </div>
            }

            <div class="col-sm-6">
                <label asp-for="SeoTitle" class="control-label">@Inventar.Resources.Resource.SEOTitle</label>
                <input asp-for="SeoTitle" class="form-control" />
                <span asp-validation-for="SeoTitle" class="text-danger"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="SeoDescription" class="control-label">@Inventar.Resources.Resource.SEODescription</label>
                <textarea asp-for="SeoDescription" class="form-control"></textarea>
                <span asp-validation-for="SeoDescription" class="text-danger"></span>
            </div>

            <div class="col-12">
                <input type="submit" value="@Inventar.Resources.Resource.Edit" class="btn btn-primary" />
            </div>
        </form>
    </div>

    <div class="col-12">
        <div class="card storefront-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h4 class="mb-1">@Inventar.Resources.Resource.ProductImages</h4>
                        <small class="text-muted">@Inventar.Resources.Resource.ImgVidUploadTxt</small>
                    </div>
                    <form asp-action="SyncGroupStorefrontImages" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-secondary" style="background:repeating-linear-gradient(45deg, lightgreen, transparent 100px)">
                            @Inventar.Resources.Resource.SyncImages
                        </button>
                    </form>
                </div>

                <form asp-action="UploadStorefrontImages" method="post" enctype="multipart/form-data" class="row g-3 mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" asp-for="Id" />
                    <div class="col-md-5">
                        <label class="control-label" for="files">Slike i video</label>
                        <input id="files" name="files" class="form-control" type="file" accept="image/*,video/*" multiple />
                    </div>

                    <div class="col-md-5">
                        <label class="control-label" for="altText">@Inventar.Resources.Resource.AltText</label>
                        <input id="altText" name="altText" class="form-control" type="text" placeholder="@Inventar.Resources.Resource.OptionalSharedAltText" /> @* Optional shared alt text for uploaded images *@
                    </div>

                    <div class="col-md-4">
                        <div class="form-check storefront-reuse-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="reuseForGroup"
                                   name="reuseForGroup"
                                   value="true" />
                            <label class="form-check-label" for="reuseForGroup">
                                @Inventar.Resources.Resource.ReuseCloudinaryImages
                            </label>
@*                             <small class="text-muted d-block">
                                This copies the same uploaded asset to other variants in the group without uploading it again.
                            </small> *@
                        </div>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-outline-primary w-100">@Inventar.Resources.Resource.Upload</button>
                    </div>
                </form>

                @if (Model.ProductImages.Count == 0)
                {
                    <div class="alert alert-light border mt-3 mb-0">@Inventar.Resources.Resource.NoImagesUploadedYet</div>
                }
                else
                {
                    <div class="row g-3 mt-2">
                        @foreach (var image in Model.ProductImages)
                        {
                            <div class="col-md-4 col-lg-3">
                                <div class="card h-100 image-card">
                                    @if (image.IsVideo)
                                    {
                                        <div class="storefront-media-frame storefront-media-frame--video">
                                            <video class="card-img-top storefront-thumb"
                                                   controls
                                                   preload="metadata"
                                                   playsinline>
                                                <source src="@image.Url" />
                                            </video>
                                            <span class="storefront-media-badge">Video</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@(image.ThumbnailUrl ?? image.Url)" alt="@(image.AltText ?? Model.Name)" class="card-img-top storefront-thumb" />
                                    }
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <strong>#@image.SortOrder</strong>
                                            @if (image.IsPrimary && !image.IsVideo)
                                            {
                                                <span class="badge bg-success">@Inventar.Resources.Resource.Primary</span>
                                            }
                                            else if (image.IsVideo)
                                            {
                                                <span class="badge bg-secondary">Video</span>
                                            }
                                        </div>
                                        <div class="small text-muted mt-2">@(image.AltText ?? "No alt text")</div>
                                    </div>
                                    <div class="card-footer bg-white border-0 d-grid gap-2">
                                        @if (!image.IsPrimary && !image.IsVideo)
                                        {
                                            <form asp-action="SetPrimaryStorefrontImage" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <input type="hidden" name="imageId" value="@image.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success w-100">@Inventar.Resources.Resource.SetPrimary</button>
                                            </form>
                                        }

                                        <form asp-action="DeleteStorefrontImage" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="imageId" value="@image.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">@Inventar.Resources.Resource.DeleteImage</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary btn-sm mt-3">@Inventar.Resources.Resource.BackToList</a>
</div>

<style>
    label {
        font-weight: 700;
        margin-bottom: 0.2rem;
    }

    textarea,
    input:not([type="checkbox"]) {
        border: 1.5px solid blueviolet !important;
    }

    .checkbox-field {
        min-height: 38px;
        display: flex;
        align-items: center;
    }

    .checkbox-field input[type="checkbox"] {
        width: 1.4rem;
        height: 1.4rem;
    }

    .storefront-card {
        border: 1px solid #ded1ff;
        box-shadow: 0 8px 20px rgba(80, 40, 140, 0.08);
    }

    .storefront-thumb {
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-bottom: 1px solid #eee;
        width: 100%;
        background: #f7f4ff;
    }

    .image-card {
        border-color: #ece3ff;
    }

    .storefront-media-frame {
        position: relative;
    }

    .storefront-media-frame--video {
        background: #f4f6fb;
    }

    .storefront-media-badge {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        background: rgba(25, 32, 56, 0.8);
        color: #fff;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .storefront-reuse-check {
        padding: 0.85rem 1rem;
        border: 1px solid #ece3ff;
        border-radius: 0.5rem;
        background: blanchedalmond;
    }

    .storefront-reuse-check .form-check-input {
        /* margin-top: 0.2rem; */
        margin-top: 0;
        margin-right:1rem;
        width:2em;
        height:2em;
        border-color: black;
    }
</style>
