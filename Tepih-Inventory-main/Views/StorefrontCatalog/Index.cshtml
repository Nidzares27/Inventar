@model IEnumerable<Inventar.Models.Tepih>
@{
    var reservedDisplay = ViewBag.ReservedDisplay as IDictionary<int, string> ?? new Dictionary<int, string>();
    var remainingSizeDisplay = ViewBag.RemainingSizeDisplay as IDictionary<int, string> ?? new Dictionary<int, string>();
    var isAdminLike = User.IsInRole("admin") || User.IsInRole("superadmin");
    var isEmployee = User.IsInRole("employee");
    var isUser = User.IsInRole("user");
    const int actionColumnIndex = 17;
    const int totalM2ColumnIndex = 9;
    const int totalQuantityColumnIndex = 12;
    const int totalAvailableColumnIndex = 14;
}

<div class="inventory-page-header">
    <h2>@Inventar.Resources.Resource.InventoryItems</h2>
</div>

<table id="TepisiTable" class="table stripe tabela inventory-table" style="font-weight:500">
    <thead>
        <tr>
            <th>#</th>
            <th>Id</th>
            <th>@Inventar.Resources.Resource.ProductNumber</th>
            <th>@Inventar.Resources.Resource.Name</th>
            <th>Model</th>
            <th>@Inventar.Resources.Resource.Color</th>
            <th>@Inventar.Resources.Resource.Size</th>
            <th>@Inventar.Resources.Resource.RemainingSize</th>
            <th>m2</th>
            <th>@Inventar.Resources.Resource.M2Total</th>
            <th>@Inventar.Resources.Resource.Price</th>
            <th>@Inventar.Resources.Resource.OnlinePrice</th>
            <th>@Inventar.Resources.Resource.Quantity</th>
            <th>@Inventar.Resources.Resource.Reserved</th>
            <th>@Inventar.Resources.Resource.Available</th>
            <th>UnID</th>
            <th>@Inventar.Resources.Resource.Published</th>
            <th></th>
        </tr>

        <tr class="filters">
            <th><input style="width:2rem" disabled></th>
            <th><input style="width:5rem" placeholder="Id"></th>
            <th><input style="width:5rem" placeholder="ProductNumber"></th>
            <th><input style="width:7.5rem" placeholder="Name"></th>
            <th><input style="width:5rem" placeholder="Model"></th>
            <th><input style="width:7.5rem" placeholder="Color"></th>
            <th><input style="width:5rem" placeholder="Size"></th>
            <th><input style="width:6rem" placeholder="Remaining"></th>
            <th><input style="width:5rem" placeholder="m2"></th>
            <th><input style="width:5rem" placeholder="M2Total"></th>
            <th><input style="width:5rem" placeholder="Price"></th>
            <th><input style="width:6rem" placeholder="Online"></th>
            <th><input style="width:5rem" placeholder="Qty"></th>
            <th><input style="width:5rem" placeholder="Reserved"></th>
            <th><input style="width:5rem" placeholder="Available"></th>
            <th><input style="width:5rem" placeholder="UnID"></th>
            <th><input style="width:5rem" placeholder="Published"></th>
            <th><input style="width:5rem" disabled></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            var itemM2 = item.PerM2 ? Math.Round(((decimal)((int)item.Length * (int)item.Width) / 10000), 2) : (decimal?)null;
            var itemM2Total = item.PerM2 ? Math.Round(((decimal)((int)item.Length * (int)item.Width) / 10000 * item.Quantity), 2) : (decimal?)null;
            var availableQuantity = Math.Max(item.Quantity - item.ReservedQuantity, 0);
            var rowClass = item.PoMjeri
                ? "inventory-row--po-mjeri"
                : item.Quantity < 0
                    ? "inventory-row--negative"
                    : item.Quantity == 0
                        ? "inventory-row--empty"
                        : item.Quantity <= 2
                            ? "inventory-row--low"
                            : "inventory-row--healthy";

            <tr class="inventory-row @rowClass">
                <td>
                    @if (isAdminLike)
                    {
                        <a asp-controller="StorefrontCatalog" asp-action="Details" asp-route-id="@item.Id"></a>
                    }
                </td>

                <td>@item.Id</td>

                <td>
                    @if (User.IsInRole("admin") || User.IsInRole("superadmin"))
                    {
                        @item.ProductNumber
                    }
                </td>

                <td>
                    @if (isEmployee)
                    {
                        <a asp-controller="StorefrontCatalog" asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                    }
                    else
                    {
                        @item.Name
                    }
                </td>
                <td>@item.Model</td>
                <td>@item.Color</td>
                <td>@((item.Width != null && item.Length != null) ? $"{item.Width}X{item.Length}" : "")</td>
                <td>@(item.PoMjeri && remainingSizeDisplay.TryGetValue(item.Id, out var remainingSize) ? remainingSize : "-")</td>
                <td>@(itemM2?.ToString("0.##") ?? "")</td>
                <td>@(itemM2Total?.ToString("0.##") ?? "")</td>

                <td style="color:@(item.PerM2 ? "green" : "black")">
                    @if (User.IsInRole("admin") || User.IsInRole("superadmin"))
                    {
                        @($"{item.Price:0.00} €")
                    }
                </td>

                <td>
                    @if (User.IsInRole("admin") || User.IsInRole("superadmin"))
                    {
                        @($"{(item.OnlinePrice ?? item.Price):0.00} €")
                    }
                </td>

                <td>@item.Quantity</td>
                <td>@(reservedDisplay.TryGetValue(item.Id, out var reservedValue) ? reservedValue : item.ReservedQuantity.ToString())</td>
                <td>@availableQuantity</td>
                <td>@item.UnID</td>
                <td>@(item.IsPublished ? "Yes" : "No")</td>

                <td>
                    @if (User.IsInRole("admin") || User.IsInRole("superadmin"))
                    {
                        <a asp-controller="StorefrontCatalog" asp-action="Edit" asp-route-id="@item.Id">@Inventar.Resources.Resource.Edit</a>
                        <a asp-controller="StorefrontCatalog" asp-action="Delete" asp-route-id="@item.Id">@Inventar.Resources.Resource.Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="inventory-summary-bar">
    <div class="inventory-summary-bar__totals">
        <span>@Inventar.Resources.Resource.TotalQuantity: <span id="totalQuantity">0</span></span>
        <span>|</span>
        <span>Available: <span id="totalAvailable">0</span></span>
        <span>|</span>
        <span>@Inventar.Resources.Resource.M2Total: <span id="totalM2">0.00</span></span>
    </div>
    <div class="inventory-legend" aria-label="Storefront catalog row colors legend">
        <span class="inventory-legend__item"><span class="inventory-legend__swatch inventory-legend__swatch--po-mjeri"></span>@Inventar.Resources.Resource.PerMeasureProduct</span>
        <span class="inventory-legend__item"><span class="inventory-legend__swatch inventory-legend__swatch--negative"></span>@Inventar.Resources.Resource.Quantity < 0</span>
        <span class="inventory-legend__item"><span class="inventory-legend__swatch inventory-legend__swatch--empty"></span>@Inventar.Resources.Resource.Quantity 0</span>
        <span class="inventory-legend__item"><span class="inventory-legend__swatch inventory-legend__swatch--low"></span>@Inventar.Resources.Resource.Quantity 1-2</span>
        <span class="inventory-legend__item"><span class="inventory-legend__swatch inventory-legend__swatch--healthy"></span>@Inventar.Resources.Resource.Quantity > 2</span>
    </div>
</div>

@if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")))
{
    <a class="btn btn-primary btn-success" href="/InventoryItem/Create">@Inventar.Resources.Resource.AddNewProduct</a>
    <button id="downloadPDF" class="btn btn-primary">@Inventar.Resources.Resource.PrintPDF</button>
}

@{
    var priceVisible = isAdminLike;
    var columnVisibility = new List<bool>
    {
        isAdminLike,
        false,
        isAdminLike,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        priceVisible,
        priceVisible,
        true,
        true,
        true,
        true,
        priceVisible,
        priceVisible
    };

    var visibilityJson = System.Text.Json.JsonSerializer.Serialize(
        columnVisibility.Select((v, i) => new { targets = i, visible = v })
    );
}

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#TepisiTable').DataTable({
                paging: true,
                pageLength: 25,
                order: [[1, "desc"]],
                orderCellsTop: true,
                fixedHeader: true,
                columnDefs: @Html.Raw(visibilityJson)
            });

            $('#TepisiTable thead tr:eq(1) th').each(function (index) {
                var input = $('input', this);
                if (input.length === 0) return;

                input.on('keyup change', function () {
                    if (table.column(index).visible()) {
                        table.column(index).search(this.value).draw();
                    }
                });
            });

            function updateTotals() {
                var totalQuantity = 0;
                var totalAvailable = 0;
                var totalM2 = 0;

                table.rows({ filter: 'applied' }).data().each(function (value) {
                    totalQuantity += parseFloat(value[@totalQuantityColumnIndex]) || 0;
                    totalAvailable += parseFloat(value[@totalAvailableColumnIndex]) || 0;
                    totalM2 += parseFloat(value[@totalM2ColumnIndex]) || 0;
                });

                $('#totalQuantity').text(totalQuantity);
                $('#totalAvailable').text(totalAvailable);
                $('#totalM2').text(totalM2.toFixed(2));
            }
            table.on('draw', function () {
                updateTotals();

                let counter = 1;
                table.rows({ search: 'applied', order: 'applied' }).every(function () {
                    var rowNumber = counter++;
                    var firstCell = $('td:eq(0)', this.node());
                    var link = firstCell.find('a');

                    if (link.length) {
                        var href = link.attr('href');
                        table.cell(this.index(), 0).data('<a href="' + href + '">' + rowNumber + '</a>');
                    } else {
                        table.cell(this.index(), 0).data(rowNumber);
                    }
                });
            });

            updateTotals();
            table.draw();
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#downloadPDF').on('click', function () {
                var table = $('#TepisiTable').DataTable();
                var visibleColumnIndexes = table
                    .columns()
                    .indexes()
                    .toArray()
                    .filter(function (columnIndex) {
                        return table.column(columnIndex).visible();
                    })
                    .filter(function (columnIndex) { return columnIndex !== @actionColumnIndex; });

                function getPlainText(value) {
                    return $('<div>').html(value ?? '').text().trim();
                }

                var data = [];

                table.rows({ search: 'applied', order: 'applied' }).every(function () {
                    var rowDataSource = this.data();
                    var rowData = [];

                    visibleColumnIndexes.forEach(function (columnIndex) {
                        rowData.push(getPlainText(rowDataSource[columnIndex]));
                    });

                    data.push(rowData);
                });

                var filters = {};
                visibleColumnIndexes.forEach(function (columnIndex, pdfIndex) {
                    filters[pdfIndex] = table.column(columnIndex).search() || "";
                });

                var heading = $('h2').text();
                var columnHeaders = visibleColumnIndexes.map(function (columnIndex) {
                    return getPlainText($(table.column(columnIndex).header()).text());
                });

                var totalQuantity = parseInt($('#totalQuantity').text()) || 0;
                var totalM2 = parseFloat($('#totalM2').text()) || 0;

                $.ajax({
                    url: '@Url.Action("GenerateInventoryPDF", "Pdf")',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        heading: heading,
                        data: data,
                        filters: filters,
                        columnHeaders: columnHeaders,
                        totalQuantity: totalQuantity,
                        totalM2: totalM2
                    }),
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function (blob) {
                        var link = document.createElement('a');
                        link.href = window.URL.createObjectURL(blob);
                        link.download = 'Inventar.pdf';
                        link.click();
                    }
                });
            });
        });
    </script>
}
