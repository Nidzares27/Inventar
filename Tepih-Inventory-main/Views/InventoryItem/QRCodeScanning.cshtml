<script>

    // ================================
    //  LIVE SEARCH FUNCTION
    // ================================
    function searchTepisi() {

        let filters = {
            name: $("#searchName").val(),
            model: $("#searchModel").val(),
            color: $("#searchColor").val(),
            size: $("#searchSize").val()
        };

        // If all fields empty → show "No results" and stop
        if (!filters.name &&
            !filters.model &&
            !filters.color &&
            !filters.size) {

            $("#rightDiv").hide().empty();
            return;
        }

        $.ajax({
            url: "/InventoryItem/SearchTepisi",
            type: "GET",
            data: filters,
            success: function (result) {

                $("#rightDiv").html("");

                if (result.length === 0) {
                    $("#rightDiv").html("<p>@Inventar.Resources.Resource.NoResultsFound</p>").show();
                    return;
                }

                let html = "<ul class='list-group'>";

                result.forEach(item => {

                    // prevent "nullXnull"
                    let sizeText = "";
                    if (item.width != null && item.length != null) {
                        sizeText = ` - ${item.width}X${item.length}`;
                    }

                    let poMjeriText = "";
                    if (item.poMjeri) {
                        let remainingSize = "";
                        if (item.remainingWidth != null && item.remainingLength != null) {
                            remainingSize = `${item.remainingWidth}X${item.remainingLength}`;
                        }

                        poMjeriText = ` - ${remainingSize}`;
                        if (item.unId) {
                            poMjeriText += ` / ${item.unId}`;
                        }
                    }

                    html += `
                        <li class="list-group-item list-group-item-action add-item"
                            data-id="${item.id}">
                            <strong>${item.productNumber}</strong> -
                            ${item.name} -
                            ${item.model} -
                            ${item.color}
                            ${sizeText}
                            ${poMjeriText}
                        </li>
                    `;
                });

                html += "</ul>";

                $("#rightDiv").html(html).show();
            },
            error: function () {
                $("#rightDiv").html(`<p>${qrScanResources.productSearchFailed}</p>`).show();
            }
        });
    }


    // ================================
    //  TRIGGER SEARCH ON INPUT
    // ================================
    $("#searchName, #searchModel, #searchColor, #searchSize")
        .on("input", function () {
            sessionStorage.setItem(this.id, this.value);  // save input
            searchTepisi();
        });


    // ================================
    //  CLICK RESULT → ADD PRODUCT
    // ================================
    $(document).on("click", ".add-item", function () {
        let id = $(this).data("id");

        fetch(`/InventoryItem/PrepareProductSelection?id=${encodeURIComponent(id)}`)
            .then(response => response.json())
            .then(handleSelectionResponse)
            .catch(error => {
                console.error(error);
                alert(qrScanResources.errorPreparingProduct);
            });
    });


    // ================================
    //  RESTORE INPUT VALUES ON REFRESH
    // ================================
    const fields = [
        "searchName",
        "searchModel",
        "searchColor",
        "searchSize"
    ];

    fields.forEach(f => {
        if (sessionStorage.getItem(f)) {
            $("#" + f).val(sessionStorage.getItem(f));
        }
    });

        // ================================
    //  RESTORE LIST ON PAGE LOAD
    // ================================
    $(document).ready(function () {
        // If any input has value, trigger search to re-render list
        let hasSavedInput = fields.some(f => sessionStorage.getItem(f) && sessionStorage.getItem(f).trim() !== "");
        if (hasSavedInput) {
            searchTepisi();
        } else {
            $("#rightDiv").hide().empty();
        }
    });


    // ================================
    //  CLEAR INPUTS BUTTON
    // ================================
    $("#clearInputs").on("click", function () {

        fields.forEach(f => {
            $("#" + f).val("");
            sessionStorage.removeItem(f);
        });

        $("#rightDiv").hide().empty();
    });

    $("#poMjeriLength").on("input", function () {
        updatePoMjeriPreview();
    });

    $("#submitPoMjeriSelection").on("click", function () {
        if (!currentPoMjeriSelection || !updatePoMjeriPreview()) {
            return;
        }

        const payload = {
            productId: Number(document.getElementById("poMjeriProductId").value),
            customWidth: Number(document.getElementById("poMjeriWidth").value),
            customLength: Number(document.getElementById("poMjeriLength").value)
        };

        fetch("/InventoryItem/AddPoMjeriScannedProduct", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
        })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    closePoMjeriModal();
                    playSuccessBeep();
                    setTimeout(() => {
                        window.location.href = `/InventoryItem/QRCodeScanning`;
                    }, 80);
                    return;
                }

    document.getElementById("poMjeriValidation").textContent = result.message || "@Inventar.Resources.Resource.FailedToAddProduct.";
            })
            .catch(error => {
                console.error(error);
    document.getElementById("poMjeriValidation").textContent = "@Inventar.Resources.Resource.FailedToAddProduct.";
            });
    });

    $("#closePoMjeriModal, .po-mjeri-modal__backdrop").on("click", function () {
        closePoMjeriModal();
    });

    $("#openProductPickerModal").on("click", function () {
        openProductPickerModal();
    });

    $("#openCreateProductModal").on("click", function () {
        openCreateProductModal();
    });

    $("#closeProductPickerModal, #productPickerModalBackdrop").on("click", function () {
        closeProductPickerModal();
    });

    $("#closeCreateProductModal, #createProductModalBackdrop").on("click", function () {
        closeCreateProductModal();
    });

</script>

