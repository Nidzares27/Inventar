 *@<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
    function onScanSuccess(qrCodeMessage) {
        fetch(`/InventoryItem/ProcessQRCode?data=${qrCodeMessage}`)
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    window.location.href = `/InventoryItem/QRCodeScanning`;
                } else {
                    document.getElementById('result').innerHTML = `
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            ${result.message}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
                }
            })
            .catch(error => {
                console.error('Fetch error:', error);
                document.getElementById('result').innerHTML = `
                    <div class="alert alert-danger">Error processing QR code.</div>`;
            });
    }

    function onScanError(errorMessage) {
        console.warn(`QR Code scan error: ${errorMessage}`);
    }

    // Delay scanner initialization after page load
    window.addEventListener("load", function () {
        setTimeout(() => {
            const html5QrcodeScanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: 250 });
            html5QrcodeScanner.render(onScanSuccess, onScanError);
        }, 1500); // Delay by 3 seconds (adjust as needed)
    });

    // var html5QrcodeScanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: 250 });
    // html5QrcodeScanner.render(onScanSuccess, onScanError);
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $(".update-quantity").click(function () {
            var itemId = $(this).data("id");
            var action = $(this).data("action");

            $.ajax({
                url: "/InventoryItem/UpdateQuantity",
                type: "POST",
                data: { id: itemId, action: action },
                success: function (newQuantity) {
                    $("#quantity-" + itemId).text(newQuantity.qty);
                    $("#m2Total-" + itemId).text(newQuantity.m2Total);
                },
                error: function () {
                    alert("Error updating quantity.");
                }
            });
        });
    });
</script>
<script>
    document.getElementById("myForm").addEventListener("submit", function (e) {
        var idInput = document.getElementById("manualId").value.trim();

        if (idInput === "") {
            e.preventDefault();
            document.getElementById("errorMessage").textContent = "Name field cannot be empty!";
        }
    });
</script>
<script>
    document.getElementById("clearSessionBtn").addEventListener("click", function () {
        fetch('/InventoryItem/ClearSession', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
            .then(response => {
                if (response.ok) {
                    location.reload();
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
    });
</script>
<script>

    // ================================
    //  LIVE SEARCH FUNCTION
    // ================================
    function searchTepisi() {

        let filters = {
            productNumber: $("#searchProductNumber").val(),
            name: $("#searchName").val(),
            model: $("#searchModel").val(),
            color: $("#searchColor").val(),
            size: $("#searchSize").val()
        };

        // If all fields empty → show "No results" and stop
        if (!filters.productNumber &&
            !filters.name &&
            !filters.model &&
            !filters.color &&
            !filters.size) {

            $("#rightDiv").html("<p>@Inventar.Resources.Resource.NoResultsFound</p>");
            return;
        }

        $.ajax({
            url: "/InventoryItem/SearchTepisi",
            type: "GET",
            data: filters,
            success: function (result) {

                $("#rightDiv").html("");

                if (result.length === 0) {
                    $("#rightDiv").html("<p>@Inventar.Resources.Resource.NoResultsFound</p>");
                    return;
                }

                let html = "<ul class='list-group'>";

                result.forEach(item => {

                    // prevent "nullXnull"
                    let sizeText = "";
                    if (item.width != null && item.length != null) {
                        sizeText = ` - ${item.width}X${item.length}`;
                    }

                    html += `
                        <li class="list-group-item list-group-item-action add-item"
                            data-id="${item.id}">
                            <strong>${item.productNumber}</strong> -
                            ${item.name} -
                            ${item.model} -
                            ${item.color}
                            ${sizeText}
                        </li>
                    `;
                });

                html += "</ul>";

                $("#rightDiv").html(html);
            }
        });
    }


    // ================================
    //  TRIGGER SEARCH ON INPUT
    // ================================
    $("#searchProductNumber, #searchName, #searchModel, #searchColor, #searchSize")
        .on("input", function () {
            sessionStorage.setItem(this.id, this.value);  // save input
            searchTepisi();
        });


    // ================================
    //  CLICK RESULT → ADD PRODUCT
    // ================================
    $(document).on("click", ".add-item", function () {
        let id = $(this).data("id");

        $.post("/InventoryItem/AddProductById", { id: id }, function () {
            location.reload(); // refresh table
        });
    });


    // ================================
    //  RESTORE INPUT VALUES ON REFRESH
    // ================================
    const fields = [
        "searchProductNumber",
        "searchName",
        "searchModel",
        "searchColor",
        "searchSize"
    ];

    fields.forEach(f => {
        if (sessionStorage.getItem(f)) {
            $("#" + f).val(sessionStorage.getItem(f));
        }
    });

        // ================================
    //  RESTORE LIST ON PAGE LOAD
    // ================================
    $(document).ready(function () {
        // If any input has value, trigger search to re-render list
        let hasSavedInput = fields.some(f => sessionStorage.getItem(f) && sessionStorage.getItem(f).trim() !== "");
        if (hasSavedInput) {
            searchTepisi();
        } else {
            // If no saved inputs, show default message
            $("#rightDiv").html("<p>@Inventar.Resources.Resource.NoResultsFound</p>");
        }
    });


    // ================================
    //  CLEAR INPUTS BUTTON
    // ================================
    $("#clearInputs").on("click", function () {

        fields.forEach(f => {
            $("#" + f).val("");
            sessionStorage.removeItem(f);
        });

        $("#rightDiv").html("<p>@Inventar.Resources.Resource.NoResultsFound</p>");
    });

</script>

<style>
    .update-quantity{
        margin-bottom: 0.2rem;
        width: 2rem;
    }
    td, th{
        text-align:center;
    }

    .disabled-link {
        pointer-events: none;
        color: gray;
        text-decoration: none;
    }

    #rightDiv {
        max-height: 520px;
        overflow-y: auto;
        border: 1px solid #ccc;
        padding: 5px;
        border-radius: 4px;
    }

    div.settings {
        display: grid;
        grid-template-columns: max-content max-content;
        grid-gap: 5px;
        margin-bottom: 1rem
    }

        div.settings label {
            text-align: right;
        }

            div.settings label:after {
                content: ":";
            }
</style>