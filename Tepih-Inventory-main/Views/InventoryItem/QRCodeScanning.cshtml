<script>
    document.getElementById("myForm").addEventListener("submit", function (e) {
        e.preventDefault();
        var idInput = document.getElementById("manualId").value.trim();

        if (idInput === "") {
            alert(qrScanResources.enterProductId);
            return;
        }

        fetch(`/InventoryItem/PrepareProductSelection?id=${encodeURIComponent(idInput)}`)
            .then(response => response.json())
            .then(handleSelectionResponse)
            .catch(error => {
                console.error(error);
                alert(qrScanResources.errorPreparingProduct);
            });
    });

    document.getElementById("formByParameters").addEventListener("submit", function (e) {
        e.preventDefault();
    });

    document.getElementById("directSaleForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const name = document.getElementById("directSaleName").value.trim();
        const price = Number(document.getElementById("directSalePrice").value || "0");
        const quantity = Number(document.getElementById("directSaleQuantity").value || "0");
        const widthValue = document.getElementById("directSaleWidth").value;
        const lengthValue = document.getElementById("directSaleLength").value;
        const width = widthValue === "" ? null : Number(widthValue);
        const length = lengthValue === "" ? null : Number(lengthValue);
        const productType = document.querySelector("input[name='directSaleProductType']:checked")?.value || "perUnit";

        if (!name) {
            alert(qrScanResources.productNameRequired);
            return;
        }

        if (!Number.isFinite(quantity) || quantity < 1) {
            alert(qrScanResources.invalidQuantity);
            return;
        }

        if (!Number.isFinite(price) || price < 0) {
            alert(qrScanResources.invalidProductPrice);
            return;
        }

        if (width !== null && (!Number.isFinite(width) || width < 1)) {
            alert(qrScanResources.invalidWidth);
            return;
        }

        if (length !== null && (!Number.isFinite(length) || length < 1)) {
            alert(qrScanResources.invalidLength);
            return;
        }

        if (productType !== "perUnit" && (width === null || length === null)) {
            alert(qrScanResources.widthAndLengthRequiredForSelectedProductType);
            return;
        }

        if (productType === "perUnit" && ((width === null) !== (length === null))) {
            alert(qrScanResources.enterBothWidthAndLength);
            return;
        }

        fetch("/InventoryItem/CreateDirectSaleProduct", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                name: name,
                price: price,
                quantity: quantity,
                width: width,
                length: length,
                productType: productType
            })
        })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    playSuccessBeep();
                    setTimeout(() => {
                        window.location.href = "/InventoryItem/QRCodeScanning";
                    }, 80);
                    return;
                }

                alert(result.message || qrScanResources.errorCreatingTemporaryProduct);
            })
            .catch(error => {
                console.error(error);
                alert(qrScanResources.errorCreatingTemporaryProduct);
            });
    });
</script>
