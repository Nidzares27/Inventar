@using Inventar.ViewModels.Inventory
@using System.Globalization
@model ScannedProductsOverviewViewModel

<div class="scanned-purchase-page">
<h2>@Inventar.Resources.Resource.BuyerInfo</h2>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<form asp-action="ScannedProductsToBePurchased" method="post" onsubmit="return validateForm()" class="scanned-purchase-form">
    <input type="hidden" class="form-control" asp-for="PurchaseTime" />
    <div class="form-group">
        <div class="row g-3 scanned-purchase-form__row">
            <div class="col-sm-6 scanned-purchase-form__name-col">
                <label for="FullName">@Inventar.Resources.Resource.FullName</label>
                <input type="text" id="FullName" class="form-control" asp-for="FullName" required autocomplete="off" />
            </div>
            <div class="col-sm-6 scanned-purchase-form__payment-col">
                <div class="row" style="height:100%; display:none">
                    <div class="form-check col" style="display: flex; align-items: center;">
                        <input class="form-check-input" type="radio" name="PlannedPaymentType" asp-for="PlannedPaymentType" value="Cash" id="cash">
                        <label class="form-check-label" for="cash" style="padding-left:1rem">
                            @Inventar.Resources.Resource.Cash
                        </label>
                    </div>
                    <div class="form-check col" style="display: flex; align-items: center;">
                        <input class="form-check-input" type="radio" name="PlannedPaymentType" asp-for="PlannedPaymentType" value="Virman" id="virman">
                        <label class="form-check-label" for="virman" style="padding-left:1rem">
                            Virman
                        </label>
                    </div>
                    <div class="form-check col" style="display: flex; align-items: center;">
                        <input class="form-check-input" type="radio" name="PlannedPaymentType" asp-for="PlannedPaymentType" value="Waiting" id="waiting" checked>
                        <label class="form-check-label" for="waiting" style="padding-left:1rem">
                            @Inventar.Resources.Resource.Waiting
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div id="suggestions" style="border-style: groove;"></div>
    </div>
    <button type="submit" class="btn btn-primary">@Inventar.Resources.Resource.ConfirmPurchase</button>
</form>
<div class="scanned-purchase-table-zoom">
<table id="productTable" class="table table-hover table-striped">
    <thead>
        <tr>
            <th scope="col">@Inventar.Resources.Resource.Name</th>
            <th scope="col">Model</th>
            <th scope="col">@Inventar.Resources.Resource.Size</th>
            <th scope="col">@Inventar.Resources.Resource.Color</th>
@*             @if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")))
            {
                <th scope="col">@Inventar.Resources.Resource.Price</th>
            }
            else
            {
                <th style="display:none" scope="col">@Inventar.Resources.Resource.Price</th>
            } *@
            <th style="display:@(User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")) ? "table-cell" : "none")" scope="col">Rabat %</th>
            <th style="display:@(User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")) ? "table-cell" : "none")" scope="col">@Inventar.Resources.Resource.Price</th>
            <th scope="col">@Inventar.Resources.Resource.Quantity</th>
            <th style="display:@(User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")) ? "table-cell" : "none")" scope="col">@Inventar.Resources.Resource.PriceTotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in  Model.Products)
        {
            <tr data-perm2="@item.PerM2"
                data-po-mjeri="@item.PoMjeri"
                data-direct-sale="@item.IsDirectSaleProduct"
                data-direct-total="@(item.DirectSaleOriginalTotal?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")"
                data-line-id="@item.LineId"
                data-product-id="@item.Id"
                data-length="@(item.Length?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")"
                data-m2-total="@(item.M2Total?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")">
                <td>
                    @item.Name
                    @if (item.IsDirectSaleProduct)
                    {
                        <div class="small text-warning-emphasis">@Inventar.Resources.Resource.TemporaryProduct</div>
                    }
                </td>
                <td>
                    @item.Model
                </td>
                @if (item.PerM2 || (!item.PerM2 && (item.Width != null && item.Length != null)))
                {
                    <td style="white-space: nowrap">
                        @($"{item.Width}X{item.Length}")
                    </td>
                }
                @if (!item.PerM2 && (item.Width == null || item.Length == null))
                {
                    <td style="white-space: nowrap"></td>
                }
                <td>
                    @item.Color
                </td>
                <td style="display:@(User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")) ? "table-cell" : "none")">
                    <input type="number"
                           style="width:5rem"
                           class="rabat"
                           value="@item.Rabat"
                           min="0"
                           max="100">
                </td>
                <td style="display:@(User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")) ? "table-cell" : "none")">
                    <input type="number"
                           style="width:5rem"
                           class="price"
                           value="@item.Price.ToString("0.00", CultureInfo.InvariantCulture)"
                           min="0"
                           step="0.01"
                           required>
                </td>
                <td id="quantity-@item.LineId" class="quantity">
                    @item.Quantity
                    @if (item.IsDirectSaleProduct)
                    {
                        <div class="small text-muted">@Inventar.Resources.Resource.FixedQuantity</div>
                    }
                </td>
                <td id="priceTotal-@item.LineId" class="priceTotal" style="color:@(item.PerM2 ? "green" : "black"); display:@(User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")) ? "table-cell" : "none")">
                    @item.PriceTotal.ToString("0.00", CultureInfo.InvariantCulture) €
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
<div class="d-flex justify-content-between align-items-center mt-2">
    <div>
        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
            <button id="printPurchasePdf" type="button" class="btn btn-primary">@Inventar.Resources.Resource.PrintPDF</button>
            <button id="createExcel" type="button" class="btn btn-success">@Inventar.Resources.Resource.Excel</button>
        </div>
    </div>
    <div style="text-align: right;">
        <strong>@Inventar.Resources.Resource.Total: <span id="totalPrice">0</span>€</strong>
    </div>
</div>

@* <div style="text-align: right; margin-top: 10px; display:@(User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("superadmin")) ? "block" : "none")">
    <strong>@Inventar.Resources.Resource.Total: <span id="totalPrice">0</span>€</strong>
</div> *@
</div>

@using System.Text.Json
@{
    // serialize Model.Products to a JS-safe payload
    var productsJson = JsonSerializer.Serialize(Model.Products);
    var purchaseTimeJson = JsonSerializer.Serialize(Model.PurchaseTime);
    var scannedPurchaseResourcesJson = JsonSerializer.Serialize(new
    {
        noProductsToExport = Inventar.Resources.Resource.ResourceManager.GetString("NoProductsToExport") ?? "No products to export.",
        errorExportingPdf = Inventar.Resources.Resource.ResourceManager.GetString("ErrorExportingPdf") ?? "An error occurred while exporting PDF.",
        errorExportingExcel = Inventar.Resources.Resource.ResourceManager.GetString("ErrorExportingExcel") ?? "An error occurred while exporting Excel.",
        confirmPdfWithoutFullName = Inventar.Resources.Resource.ResourceManager.GetString("ConfirmPdfWithoutBuyerFullName") ?? "Do you want to print PDF without entering buyer's full name?",
        confirmExcelWithoutFullName = Inventar.Resources.Resource.ResourceManager.GetString("ConfirmExcelWithoutBuyerFullName") ?? "Do you want to print Excel without entering buyer's full name?"
    });
}

<style>
    td, th {
        text-align: center;
    }

    .scanned-purchase-form__row {
        margin-bottom: 1rem;
    }

    .scanned-purchase-form__name-col {
        padding-right: 2rem;
    }

    .scanned-purchase-form__payment-col {
        padding-left: 2rem;
    }

    input{
        border: 2px solid #111 !important;
    }

    .input-locked {
        background-color: #f3f3f3;
        cursor: not-allowed;
    }

        input.is-invalid {
            border-color: red !important;
            background-color: #ffe6e6;
        }

    #suggestions {
        border: 1px solid #ccc;
        max-width: 300px;
        display: none;
        position: absolute;
        background: white;
        z-index: 1000;
    }

    .suggestion-item {
        padding: 8px;
        cursor: pointer;
    }

        .suggestion-item:hover {
            background: #007bff;
            color: white;
        }

    @@media (max-width: 768px) {
        .scanned-purchase-page {
            overflow-x: hidden;
        }

        .scanned-purchase-form__name-col,
        .scanned-purchase-form__payment-col {
            padding-right: calc(var(--bs-gutter-x) * .5);
            padding-left: calc(var(--bs-gutter-x) * .5);
        }

        .scanned-purchase-table-zoom {
            zoom: 0.60;
        }

        .container-fluid {
            padding-right: 0;
            padding-left: 0;
        }

        #productTable {
            margin-bottom: 0.75rem;
        }

        .d-flex.justify-content-between.align-items-center.mt-2 {
            flex-direction: column;
            align-items: stretch !important;
            gap: 0.75rem;
        }

        .d-flex.justify-content-between.align-items-center.mt-2 > div {
            text-align: center !important;
        }

        .d-flex.justify-content-between.align-items-center.mt-2 .btn {
            width: 100%;
        }
    }
</style>
<script>
    function parseUiNumber(value) {
        if (value == null) {
            return 0;
        }

        const normalizedValue = value
            .toString()
            .replace(/\s/g, "")
            .replace("€", "")
            .replace(",", ".");

        const parsedValue = parseFloat(normalizedValue);
        return Number.isFinite(parsedValue) ? parsedValue : 0;
    }

    function calculateLengthFactor(lengthValue) {
        const normalizedLength = Math.max(parseUiNumber(lengthValue), 100);
        return normalizedLength / 100;
    }

    function calculateRowBaseTotal(row, price, quantity, m2Total) {
        const perM2 = row.dataset.perm2 === "True";
        const poMjeri = row.dataset.poMjeri === "True";

        if (poMjeri) {
            return price * calculateLengthFactor(row.dataset.length) * quantity;
        }

        if (perM2) {
            return price * m2Total;
        }

        return price * quantity;
    }

    function calculateTotal() {
        let sum = 0;
        document.querySelectorAll(".priceTotal").forEach(function (element) {
            sum += parseUiNumber(element.textContent);
        });
        document.getElementById("totalPrice").textContent = sum.toFixed(2);
    }

    function calculateTotalWithRabat() {
        let sum = 0;
        let priceTotals = document.querySelectorAll(".priceTotal");
        let rabats = document.querySelectorAll(".rabat");
        let pm2s = document.querySelectorAll("tr[data-perm2]");
        let prices = document.querySelectorAll(".price");
        let quantitys = document.querySelectorAll(".quantity");

        for (let i = 0; i < priceTotals.length; i++) {
            let row = pm2s[i];
            let priceTotal = parseUiNumber(priceTotals[i].textContent);
            let rabat = parseUiNumber(rabats[i].value);
            let price = parseUiNumber(prices[i].value);
            let quantity = parseInt(quantitys[i].textContent);
            let m2Total = parseUiNumber(row.dataset.m2Total || "0");
            let totalPrice = calculateRowBaseTotal(row, price, quantity, m2Total);

            if (rabat) {
                let rbt = rabat / 100;
                totalPrice -= rbt * totalPrice;
                sum += totalPrice;
            } else {
                sum += priceTotal;
            }

            priceTotals[i].textContent = totalPrice.toFixed(2) + "€";
        }
        document.getElementById("totalPrice").textContent = sum.toFixed(2);
    }

    calculateTotal();
    document.addEventListener("DOMContentLoaded", function () {
        function updateRow(row) {
            let priceInput = row.querySelector(".price");
            let rabatInput = row.querySelector(".rabat");

            let price = parseUiNumber(row.querySelector(".price").value);
            let quantity = parseInt(row.querySelector(".quantity").textContent) || 0;
            let m2Total = parseUiNumber(row.dataset.m2Total || "0");
            let rabat = parseInt(row.querySelector(".rabat").value);

            // Basic validation
            if (isNaN(price) || price < 0) {
                priceInput.classList.add("is-invalid");
                return; // skip update if invalid
            } else {
                priceInput.classList.remove("is-invalid");
            }

            let totalPrice = calculateRowBaseTotal(row, price, quantity, m2Total);

            if (rabat) {
                let rbt = rabat / 100;
                totalPrice -= rbt * totalPrice;
            }

            row.querySelector(".priceTotal").textContent = totalPrice.toFixed(2) + "€";

            calculateTotal();
                // --- Sync updated values into productsForExport array --- //
            let lineId = row.dataset.lineId;
            let p = productsForExport.find(x => x.LineId === lineId);

            if (p) {
                p.Rabat = rabat;
                p.Price = price;
                p.PriceTotal = Number(totalPrice.toFixed(2));

                if (p.IsDirectSaleProduct) {
                    p.DirectSaleOriginalTotal = p.PriceTotal;
                }
            }

            saveToServer(row.dataset.lineId, price, rabat);
        }

        function saveToServer(lineId, price, rabat) {
            let data = {
                lineId: lineId,
                price: Number(price),
                rabat: Number(rabat),
            };

            fetch('/InventoryItem/Update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success === false && data.message) {
                        alert(data.message);
                    }
                })
                .catch(error => console.error("Error:", error));
        }

        document.querySelectorAll("#productTable tbody tr").forEach(row => {
            row.querySelectorAll(".price,.rabat").forEach(input => {
                input.addEventListener("input", function () {
                    updateRow(row);
                });
            });
        });
    });
</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#FullName").on("input", function () {
            let query = $(this).val().trim();
            if (query.length < 3) {
                $("#suggestions").hide();
                return;
            }

            $.getJSON("/InventoryItem/SearchPeople", { query: query }, function (data) {
                let suggestions = $("#suggestions");
                suggestions.empty();

                if (data.length === 0) {
                    suggestions.hide();
                    return;
                }

                data.forEach(function (name) {
                    suggestions.append(`<div class="suggestion-item">${name}</div>`);
                });

                suggestions.show();
            });
        });

        // Fill the input field when user clicks on a suggestion
        $(document).on("click", ".suggestion-item", function () {
            $("#FullName").val($(this).text());
            $("#suggestions").hide();
        });

        // Hide suggestions if user clicks outside
        $(document).click(function (e) {
            if (!$(e.target).closest("#FullName, #suggestions").length) {
                $("#suggestions").hide();
            }
        });
    });
</script>
<script>
    function validateForm() {
        let valid = true;
        document.querySelectorAll(".price").forEach(input => {
            if (!input.value || parseUiNumber(input.value) < 0) {
                input.classList.add("is-invalid");
                valid = false;
            } else {
                input.classList.remove("is-invalid");
            }
        });

        return valid;
    }
</script>
<script>
    // Prefilled client-side copies from server model (so you don't need to gather table DOM)
    const productsForExport = @Html.Raw(productsJson);
    const purchaseTimeForExport = @Html.Raw(purchaseTimeJson); // will be JSON Date if DateTime
    const scannedPurchaseResources = @Html.Raw(scannedPurchaseResourcesJson);

    function downloadBlobAsFile(blob, filename) {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.URL.revokeObjectURL(url);
    }

    async function exportPurchaseDocument(url, fallbackFileName, errorMessage) {
        if (!productsForExport || productsForExport.length === 0) {
            alert(scannedPurchaseResources.noProductsToExport);
            return;
        }

        try {
            const payload = {
                FullName: document.getElementById("FullName").value.trim(),
                PurchaseTime: purchaseTimeForExport,
                Products: productsForExport
            };

            const resp = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (!resp.ok) {
                const txt = await resp.text();
                alert(txt || errorMessage);
                return;
            }

            const contentDisposition = resp.headers.get('content-disposition');
            let fileName = fallbackFileName;
            if (contentDisposition && contentDisposition.indexOf('filename=') !== -1) {
                const match = /filename\*?=(?:UTF-8'')?["']?([^;"']+)["']?/.exec(contentDisposition);
                if (match && match[1]) {
                    fileName = decodeURIComponent(match[1]);
                }
            }

            const blob = await resp.blob();
            downloadBlobAsFile(blob, fileName);
        } catch (ex) {
            console.error(ex);
            alert(errorMessage);
        }
    }

    function confirmExportWithoutFullName(message) {
        const fullName = document.getElementById("FullName")?.value.trim() ?? "";
        if (fullName) {
            return true;
        }

        return confirm(message);
    }

    document.getElementById('printPurchasePdf').addEventListener('click', async function () {
        if (!confirmExportWithoutFullName(scannedPurchaseResources.confirmPdfWithoutFullName)) {
            return;
        }

        await exportPurchaseDocument('/InventoryItem/ExportScannedProductsToPdf', 'purchase.pdf', scannedPurchaseResources.errorExportingPdf);
    });

    document.getElementById('createExcel').addEventListener('click', async function () {
        if (!confirmExportWithoutFullName(scannedPurchaseResources.confirmExcelWithoutFullName)) {
            return;
        }

        try {
            // Build payload
            const payload = {
                FullName: document.getElementById("FullName").value.trim(),
                PurchaseTime: purchaseTimeForExport,
                Products: productsForExport
            };

            const resp = await fetch('/InventoryItem/ExportScannedProductsToExcel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (!resp.ok) {
                const txt = await resp.text();
                alert(txt || scannedPurchaseResources.errorExportingExcel);
                return;
            }

            // Get filename from content-disposition header if present
            const contentDisposition = resp.headers.get('content-disposition');
            let fileName = 'export.xlsx';
            if (contentDisposition && contentDisposition.indexOf('filename=') !== -1) {
                const match = /filename\*?=(?:UTF-8'')?["']?([^;"']+)["']?/.exec(contentDisposition);
                if (match && match[1]) {
                    fileName = decodeURIComponent(match[1]);
                }
            } else {
                // fallback: server should have constructed filename from purchaseTime + fullname
                fileName = `${new Date().toLocaleString().replace(/:/g, '.')}.xlsx`;
            }

            const blob = await resp.blob();
            downloadBlobAsFile(blob, fileName);
        } catch (ex) {
            console.error(ex);
            alert(scannedPurchaseResources.errorExportingExcel);
        }
    });
</script>
