@model Tepih
@{
    var createSuccessMessage = TempData["CreateSuccessMessage"] as string;
    var createQrPdfUrl = TempData["CreateQrPdfUrl"] as string;
}

<h2>@Inventar.Resources.Resource.CreateProduct</h2>
@if (!string.IsNullOrWhiteSpace(createSuccessMessage))
{
    <div id="createSuccessAlert"
         class="alert alert-success alert-dismissible fade show d-flex flex-wrap align-items-center gap-2"
         role="alert"
         data-auto-download-url="@createQrPdfUrl">
        <span>@createSuccessMessage</span>
@*         @if (!string.IsNullOrWhiteSpace(createQrPdfUrl))
        {
            <span class="small text-success-emphasis">QR PDF preuzimanje je pokrenuto automatski.</span>
            <a class="btn btn-outline-success btn-sm" href="@createQrPdfUrl" target="_blank" rel="noopener">Preuzmi QR PDF</a>
        } *@
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<small style="color:red">@Inventar.Resources.Resource.MandatoryFields</small>
@if (TempData["MissingLengthWidth"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["MissingLengthWidth"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<br />

<form id="createForm" class="row g-3" asp-action="Create" method="post" style="margin-top:0.5rem">
    <input type="hidden" class="form-control" asp-for="DateTime" />
    <input type="hidden" class="form-control" asp-for="Prodaje" />
    <div class="col-sm-3">
        <label for="ProductNumber">@Inventar.Resources.Resource.ProductNumber<span style="color:red">*</span></label>
        <input type="text" class="form-control" asp-for="ProductNumber" />
    </div>
    <div class="col-sm-6">
        <label for="Name">@Inventar.Resources.Resource.Name<span style="color:red">*</span></label>
        <input type="text" class="form-control" asp-for="Name" />
    </div>
    <div class="col-sm-3">
        <label for="Model">Model<span style="color:red">*</span></label>
        <input type="text" class="form-control" asp-for="Model" />
    </div>
    <div class="col-sm-6">
@*         <label asp-for="BroaderCategory"></label><span style="color:red">*</span>
 *@        <label for="BroaderCategory">@Inventar.Resources.Resource.BroaderCategory<span style="color:red">*</span></label>
        <input type="text" class="form-control" asp-for="BroaderCategory" />
        <span asp-validation-for="BroaderCategory" class="text-danger"></span>
    </div>
    <div class="col-sm-6">
@*         <label asp-for="NarrowerCategory"></label><span style="color:red">*</span>
 *@        <label for="NarrowerCategory">@Inventar.Resources.Resource.NarrowerCategory<span style="color:red">*</span></label>
        <input type="text" class="form-control" asp-for="NarrowerCategory" />
        <span asp-validation-for="NarrowerCategory" class="text-danger"></span>
    </div>
    <div class="col-sm-6">
        <label for="Color">@Inventar.Resources.Resource.Color<span style="color:red">*</span></label>
        <input type="text" class="form-control" asp-for="Color" />
    </div>
    <div class="col-sm-3">
        <label for="Length">@Inventar.Resources.Resource.Length</label>
        <input id="Length" type="number" step="any" class="form-control" asp-for="Length" />
    </div>
    <div class="col-sm-3">
        <label for="Width">@Inventar.Resources.Resource.Width</label>
        <input id="Width" type="number" step="any" class="form-control" asp-for="Width" />
    </div>
    <div class="col-sm-6">
        <label for="Quantity">@Inventar.Resources.Resource.Quantity<span style="color:red">*</span></label>
        <input type="number" class="form-control" asp-for="Quantity" />
    </div>
    <div class="col-sm-6">
        <label for="Price">@Inventar.Resources.Resource.Price<span style="color:red">*</span></label>
        <input type="number" step="0.01" class="form-control" asp-for="Price" value="@(Model.Price == 0 ? string.Empty : Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" />
    </div>
    <div class="col-sm-6">
        <label for="Description">@Inventar.Resources.Resource.Description</label>
        <textarea class="form-control" asp-for="Description"></textarea>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input type="checkbox" id="PerM2" asp-for="PerM2" style="vertical-align:middle" />
            <label for="PerM2" style="vertical-align:middle; margin-bottom:0">@Inventar.Resources.Resource.PerM2</label>
        </div>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input type="checkbox" id="PoMjeri" asp-for="PoMjeri" style="vertical-align:middle" />
            <label for="PoMjeri" style="vertical-align:middle; margin-bottom:0">@Inventar.Resources.Resource.PerMeasure</label>
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">@Inventar.Resources.Resource.CreateProduct</button>
    </div>
</form>
<div id="loading-spinner-prodCreate" class="spinner-wrapper" style="display:none; text-align: center;">
    <div class="spinner-border text-danger" role="status">
        <span class="sr-only" id="loadingText"></span>
    </div>
    <div style="color:firebrick; font-size:larger">@Inventar.Resources.Resource.CreatingProduct</div>
</div>
<script>
    document.getElementById("createForm").addEventListener("submit", function (event) {
        document.getElementById("loading-spinner-prodCreate").style.display = "flex";

        setTimeout(function () {
            document.getElementById("loading-spinner-prodCreate").style.display = "none";
        }, 3000);
    });

    function syncPoMjeriWithPerM2() {
        const poMjeriCheckbox = document.getElementById("PoMjeri");
        const perM2Checkbox = document.getElementById("PerM2");

        if (poMjeriCheckbox.checked) {
            perM2Checkbox.checked = true;
        }
    }

    document.getElementById("PoMjeri").addEventListener("change", syncPoMjeriWithPerM2);
    document.getElementById("PerM2").addEventListener("change", function () {
        if (document.getElementById("PoMjeri").checked) {
            this.checked = true;
        }
    });

    syncPoMjeriWithPerM2();

    const createSuccessAlert = document.getElementById("createSuccessAlert");
    const autoDownloadUrl = createSuccessAlert?.dataset.autoDownloadUrl;

    if (autoDownloadUrl) {
        const downloadFrame = document.createElement("iframe");
        downloadFrame.style.display = "none";
        downloadFrame.src = autoDownloadUrl;
        downloadFrame.setAttribute("aria-hidden", "true");
        document.body.appendChild(downloadFrame);
    }
</script>
