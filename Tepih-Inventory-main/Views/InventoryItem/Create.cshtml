    label{
        margin-bottom: 0.5rem;
        font-weight: 700;
    }

    textarea{
        border: 1.5px solid blueviolet !important;
    }

    input {
        border: 1.5px solid blueviolet !important;
    }

        input[type="checkbox"] {
            width: 2rem;
            height: 2rem;
            border: 5px !important solid blueviolet;
