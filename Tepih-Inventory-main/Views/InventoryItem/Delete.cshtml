@model Inventar.Models.Tepih
<link rel="stylesheet" href="~/css/Details.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Delete";
}

<style>
    @@media (max-width: 768px) {
        .inventory-delete-mobile-zoom {
            zoom: 0.82;
        }

        .container-fluid {
            padding-right: 0;
            padding-left: 0;
        }
    }
</style>

<div class="details-page">
<h1 class="details-page__title">@Inventar.Resources.Resource.DeleteProduct</h1>

<h3 class="details-page__subtitle">@Inventar.Resources.Resource.DeleteThis</h3>
<div>
    <hr />
    <div class="inventory-delete-mobile-zoom">
    <table class="custom-table custom-table--details">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <td>@Html.DisplayFor(model => model.Id)</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.Name</th>
            <td>@Html.DisplayFor(model => model.Name)</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.ProductNumber</th>
            <td>@Html.DisplayFor(model => model.ProductNumber)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Model)</th>
            <td>@Html.DisplayFor(model => model.Model)</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.DateTime</th>
            <td>@Html.DisplayFor(model => model.DateTime)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(model => model.QRCodeUrl)</th>
            <td>
                <span class="details-page__qr-url">@Html.DisplayFor(model => model.QRCodeUrl)</span>
                <div class="details-page__qr-code">
                    @if (!string.IsNullOrEmpty(Model.QRCodeUrl))
                    {
                        <img src="@Model.QRCodeUrl" alt="QR Code" class="img-fluid rounded" style="max-height:150px;" />
                    }
                    else
                    {
                        <span>N/A</span>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.Quantity</th>
            <td>@Html.DisplayFor(model => model.Quantity)</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.Length</th>
            <td>@Html.DisplayFor(model => model.Length)</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.Width</th>
            <td>@Html.DisplayFor(model => model.Width)</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.Color</th>
            <td>@Html.DisplayFor(model => model.Color)</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.Price</th>
            <td>@Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) €</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.PerM2</th>
            <td>@Html.DisplayFor(model => model.PerM2)</td>
        </tr>
        <tr>
            <th>@Inventar.Resources.Resource.Description</th>
            <td>@Html.DisplayFor(model => model.Description)</td>
        </tr>
    </table>
    </div>

    <form asp-action="Delete" class="details-page__actions">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="@Inventar.Resources.Resource.Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary btn-sm">@Inventar.Resources.Resource.BackToList</a>
    </form>
</div>
</div>
