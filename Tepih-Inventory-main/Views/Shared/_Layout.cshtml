                                        <li><a class="dropdown-item" asp-area="" asp-controller="InventoryReports" asp-action="ByM2" data-loading="true">@Inventar.Resources.Resource.ReportByM2</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="InventoryReports" asp-action="ByPiece" data-loading="true">@Inventar.Resources.Resource.ReportPerUnit</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="InventoryReports" asp-action="BySize" data-loading="true">@Inventar.Resources.Resource.ReportBySize</a></li>
