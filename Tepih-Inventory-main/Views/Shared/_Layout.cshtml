<!DOCTYPE html>
@using System.Globalization
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@requestVerificationToken" />
    <script>
        document.documentElement.classList.add('inventar-js');
    </script>
    <style>
        html.inventar-js body:not(.inventar-page-ready) #global-loading-spinner,
        html.inventar-js body.inventar-navigation-loading #global-loading-spinner {
            display: flex !important;
        }

        html.inventar-js body:not(.inventar-page-ready) {
            overflow: hidden;
        }

        #global-loading-spinner {
            background-color: black;
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: none;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            transition: all 0.2s;
        }

        #global-loading-spinner .spinner-border {
            height: 90px;
            width: 90px;
            animation-timing-function: ease;
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventar.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.dataTables.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

</head>
<body data-datatable-state-scope="@(User.Identity?.Name ?? "anonymous")">
