    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>  
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        window.InventarExportMessages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            pdf = Inventar.Resources.Resource.ResourceManager.GetString("CreatingPdfFile") ?? "Creating PDF file...",
            excel = Inventar.Resources.Resource.ResourceManager.GetString("CreatingExcelFile") ?? "Creating Excel file...",
            file = Inventar.Resources.Resource.Searching
        }));
    </script>

    <script>
        (function () {
            const token = document.querySelector('meta[name="request-verification-token"]')?.getAttribute('content');
            if (!token) {
                return;
            }

            const safeMethods = new Set(["GET", "HEAD", "OPTIONS", "TRACE"]);
            const isSameOrigin = (urlValue) => {
                try {
                    const url = new URL(urlValue || window.location.href, window.location.origin);
                    return url.origin === window.location.origin;
                } catch {
                    return true;
                }
            };

            if (window.fetch) {
                const originalFetch = window.fetch.bind(window);
                window.fetch = function (input, init) {
                    const method = (init?.method || (input instanceof Request ? input.method : "GET")).toUpperCase();
                    const urlValue = typeof input === "string" || input instanceof URL
                        ? input.toString()
                        : input instanceof Request
                            ? input.url
                            : window.location.href;

                    if (!safeMethods.has(method) && isSameOrigin(urlValue)) {
                        const headers = new Headers(init?.headers || (input instanceof Request ? input.headers : undefined));
                        if (!headers.has("RequestVerificationToken")) {
                            headers.set("RequestVerificationToken", token);
                        }

                        return originalFetch(input, { ...init, headers });
                    }

                    return originalFetch(input, init);
                };
            }

            if (window.jQuery) {
                $.ajaxPrefilter(function (options) {
                    const method = (options.type || options.method || "GET").toUpperCase();
                    if (safeMethods.has(method) || !isSameOrigin(options.url || window.location.href)) {
                        return;
                    }

                    options.headers = options.headers || {};
                    if (!options.headers["RequestVerificationToken"]) {
                        options.headers["RequestVerificationToken"] = token;
                    }
                });
            }
        })();
    </script>

    <script>
        if (window.InventarPageLoader) {
            window.InventarPageLoader.initialize();
            window.InventarPageLoader.initializeDataTableTracking();
        }

        window.InventarExportFeedback?.initializeJQueryTracking();
    </script>

    <script>
        if (window.InventarDataTableState) {
            window.InventarDataTableState.initialize();
        } else if (window.jQuery && $.fn && $.fn.dataTable) {
            $.extend(true, $.fn.dataTable.defaults, {
                pageLength: 25,
                stateSave: true,
                stateDuration: -1
            });
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const links = document.querySelectorAll('a[data-loading="true"]');
            links.forEach(link => {
                link.addEventListener("click", function () {
                    window.InventarPageLoader?.showForNavigation();
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
