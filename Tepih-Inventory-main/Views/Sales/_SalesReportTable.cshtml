@using Inventar.ViewModels.Sales
@using Inventar.Utils
@model PerProductViewModel
@if (Model.StartDate.HasValue && Model.EndDate.HasValue)
{
    <p id="dateStartEnd">
        <b style="color:mediumblue">@Model.StartDate.Value.ToString("dd-MM-yyyy")</b> --- <b style="color:mediumblue">@Model.EndDate.Value.ToString("dd-MM-yyyy")</b>
    </p>
}

@if (Model.SalesReport != null && Model.SalesReport.Any())
{
    <div class="sales-report-table-zoom">
    @if (Model.IsGrouped)
    {
        <table id="PerProductsTable" class="table stripe" style="width:100%; font-weight:500">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@Inventar.Resources.Resource.Name</th>
                    <th>@Inventar.Resources.Resource.ProductNumber</th>
                    <th>@Inventar.Resources.Resource.Size</th>
                    <th>m²</th>
                    <th>@Inventar.Resources.Resource.M2Total</th>
                    <th>@Inventar.Resources.Resource.TotalQuantity</th>
                    <th>@Inventar.Resources.Resource.TotalPrice</th>
                </tr>
                <tr class="filters">
                    <th><input class="per-products-filter-input" data-column-index="0" style="width:2rem" type="text" placeholder="" disabled></th>
                    <th><input class="per-products-filter-input" data-column-index="1" style="width:7.5rem" type="text" placeholder="Name" /></th>
                    <th><input class="per-products-filter-input" data-column-index="2" style="width:5rem" type="text" placeholder="" /></th>
                    <th><input class="per-products-filter-input" data-column-index="3" style="width:5rem" type="text" placeholder="Size" /></th>
                    <th><input class="per-products-filter-input" data-column-index="4" style="width:5rem" type="text" placeholder="m²" /></th>
                    <th><input class="per-products-filter-input" data-column-index="5" style="width:5rem" type="text" placeholder="M2Total" /></th>
                    <th><input class="per-products-filter-input" data-column-index="6" style="width:5rem" type="text" placeholder="Total Quantity" /></th>
                    <th><input class="per-products-filter-input" data-column-index="7" style="width:5rem" type="text" placeholder="Total Price" /></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SalesReport)
                {
                    var m2 = PoMjeriHelper.CalculateM2PerUnit(item.PerM2, item.Width, item.Length);
                    var m2Total = PoMjeriHelper.CalculateM2Total(item.PerM2, item.Width, item.Length, item.TotalQuantity);
                    <tr>
                       <td></td>
                       <td>
                            @{
                                var currentQuery = Context.Request.QueryString.ToString();
                            }
                            <a asp-action="DetailsGrouped" asp-controller="Sales"
                               asp-route-name="@item.Name"
                               asp-route-length="@item.Length"
                               asp-route-width="@item.Width"
                               asp-route-productNumber="@item.ProductNumber"
                               asp-route-buyer="@Model.CustomerFullName"
                               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               target="_blank">
                                @item.Name
                            </a>
                        </td>
                        <td>@item.ProductNumber</td>
                        <td>@(item.Size ?? "")</td>
                        <td>@(m2?.ToString("0.##") ?? "")</td>
                        <td>@(m2Total?.ToString("0.##") ?? "")</td>
                        <td>@item.TotalQuantity</td>
                        <td style="color:@(item.PerM2 ? "green" : "black")">@string.Format("{0:F2}", item.TotalPrice)€</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <table id="PerProductsTable" class="table stripe" style="width:100%; font-weight:500">
            <thead>
                <tr>
                    <th>#</th>
                    <th style="display:none">@Inventar.Resources.Resource.ProductID</th>
                    <th>@Inventar.Resources.Resource.ProductNumber</th>
                    <th>@Inventar.Resources.Resource.Name</th>
                    <th>Model</th>
                    <th>@Inventar.Resources.Resource.Color</th>
                    <th>@Inventar.Resources.Resource.Size</th>
                    <th>m²</th>
                    <th>@Inventar.Resources.Resource.M2Total</th>
                    <th>@Inventar.Resources.Resource.TotalQuantity</th>
                    <th>@Inventar.Resources.Resource.TotalPrice</th>
                </tr>
                <tr class="filters">
                    <th><input class="per-products-filter-input" data-column-index="0" style="width:2rem" type="text" placeholder="" disabled></th>
                    <th style="display:none"><input class="per-products-filter-input" data-column-index="1" style="width:5rem" type="text" placeholder="Product ID"></th>
                    <th><input class="per-products-filter-input" data-column-index="2" style="width:5rem" type="text" placeholder=""></th>
                    <th><input class="per-products-filter-input" data-column-index="3" style="width:7.5rem" type="text" placeholder="Name"></th>
                    <th><input class="per-products-filter-input" data-column-index="4" style="width:5rem" type="text" placeholder="Model"></th>
                    <th><input class="per-products-filter-input" data-column-index="5" style="width:7.5rem" type="text" placeholder="Color"></th>
                    <th><input class="per-products-filter-input" data-column-index="6" style="width:5rem" type="text" placeholder="Size"></th>
                    <th><input class="per-products-filter-input" data-column-index="7" style="width:5rem" type="text" placeholder="m²"></th>
                    <th><input class="per-products-filter-input" data-column-index="8" style="width:5rem" type="text" placeholder="M2Total"></th>
                    <th><input class="per-products-filter-input" data-column-index="9" style="width:5rem" type="text" placeholder="Total Quantity"></th>
                    <th><input class="per-products-filter-input" data-column-index="10" style="width:5rem" type="text" placeholder="Total Price"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SalesReport)
                {
                    var m2PerProduct = PoMjeriHelper.CalculateM2PerUnit(item.PerM2, item.Width, item.Length);
                    var m2Total = PoMjeriHelper.CalculateM2Total(item.PerM2, item.Width, item.Length, item.TotalQuantity);

                    <tr>
                        <td>
                            <a asp-action="DetailsUngrouped"
                               asp-route-productId="@item.ProductId"
                               asp-route-productNumber="@item.ProductNumber"
                               asp-route-name="@item.Name"
                               asp-route-model="@item.Model"
                               asp-route-size="@(item.Size ?? "")"
                               asp-route-length="@item.Length"
                               asp-route-width="@item.Width"
                               asp-route-m2PerProduct="@(m2PerProduct?.ToString() ?? "")" 
                               asp-route-color="@item.Color"
                               asp-route-buyer="@Model.CustomerFullName"
                               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               target="_blank"></a>
                        </td>
                        <td style="display:none">
                            @item.ProductId
                        </td>
                        <td>@item.ProductNumber</td>
                        <td>@item.Name</td>
                        <td>@item.Model</td>
                        <td>@item.Color</td>
                        <td>@(item.Size ?? "")</td>
                        <td>@(m2PerProduct?.ToString("0.##") ?? "")</td>
                        <td>@(m2Total?.ToString("0.##") ?? "")</td>
                        <td>@item.TotalQuantity</td>
                        <td style="color:@(item.PerM2 ? "green" : "black")">@string.Format("{0:F2}", item.TotalPrice)€</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    </div>
}
else
{
    <p>@Inventar.Resources.Resource.NoResultsFound</p>
}
