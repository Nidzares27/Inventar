@using System.Text.Json
@using Inventar.Utils
@model Inventar.ViewModels.StorefrontAdmin.WebOrderAdminDetailsViewModel

@{
    ViewData["Title"] = "Storefront Order";
    var customerName = $"{Model.Order.CustomerFirstName} {Model.Order.CustomerLastName}".Trim();
    var editableItemsJson = JsonSerializer.Serialize(Model.EditableItems);
    var canManageInternalNote = User.IsInRole("admin") || User.IsInRole("superadmin");
    var poMjeriAllocationsByItemId = Model.PoMjeriItems.ToDictionary(item => item.Item.Id, item => item.ActiveReservations);
}

<h2>@Inventar.Resources.Resource.Order @Model.Order.OrderNumber</h2>

@if (TempData["StorefrontOrderSuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["StorefrontOrderErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning">@errorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h4>@Inventar.Resources.Resource.OrderSummary</h4>
                <dl class="row mb-0">
                    <dt class="col-sm-5">@Inventar.Resources.Resource.Customer</dt>
                    <dd class="col-sm-7">@customerName</dd>

                    <dt class="col-sm-5">Email</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.Order.CustomerEmail) ? "-" : Model.Order.CustomerEmail)</dd>

                    <dt class="col-sm-5">@Inventar.Resources.Resource.Phone</dt>
                    <dd class="col-sm-7">@(Model.Order.CustomerPhone ?? "-")</dd>

                    <dt class="col-sm-5">@Inventar.Resources.Resource.Created</dt>
                    <dd class="col-sm-7">@Model.Order.CreatedUtc.ToString("dd-MM-yyyy HH:mm") UTC</dd>

                    <dt class="col-sm-5">@Inventar.Resources.Resource.Status</dt>
                    <dd class="col-sm-7">@StorefrontStatusLocalizer.Localize(Model.Order.Status)</dd>

                    <dt class="col-sm-5">@Inventar.Resources.Resource.Payment</dt>
                    <dd class="col-sm-7">@StorefrontStatusLocalizer.Localize(Model.Order.PaymentStatus)</dd>

                    <dt class="col-sm-5">@Inventar.Resources.Resource.Fulfillment</dt>
                    <dd class="col-sm-7">@StorefrontStatusLocalizer.Localize(Model.Order.FulfillmentStatus)</dd>

                    <dt class="col-sm-5">@Inventar.Resources.Resource.Total</dt>
                    <dd class="col-sm-7">@($"{Model.Order.GrandTotal:0.00} EUR")</dd>

                    <dt class="col-sm-5">@Inventar.Resources.Resource.Paid</dt>
                    <dd class="col-sm-7">@(Model.Order.PaidUtc?.ToString("dd-MM-yyyy HH:mm") ?? "-")</dd>

                    @if (canManageInternalNote)
                    {
                        <dt class="col-sm-5">@Inventar.Resources.Resource.InternalNote</dt>
                        <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.Order.InternalNote) ? Model.Order.InternalNote : "-")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h4>@Inventar.Resources.Resource.UpdateStatus</h4>
                <form asp-action="UpdateStatus" asp-route-id="@Model.Order.Id" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="StatusUpdate.WebOrderId" />

                    <div class="col-md-4">
                        <label asp-for="StatusUpdate.Status" class="form-label">@Inventar.Resources.Resource.OrderStatus</label>
                        <select asp-for="StatusUpdate.Status" class="form-select">
                            @foreach (var status in Model.AvailableOrderStatuses)
                            {
                                <option value="@status">@StorefrontStatusLocalizer.Localize(status)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StatusUpdate.PaymentStatus" class="form-label">@Inventar.Resources.Resource.PaymentStatus</label>
                        <select asp-for="StatusUpdate.PaymentStatus" class="form-select">
                            @foreach (var paymentStatus in Model.AvailablePaymentStatuses)
                            {
                                <option value="@paymentStatus">@StorefrontStatusLocalizer.Localize(paymentStatus)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StatusUpdate.FulfillmentStatus" class="form-label">@Inventar.Resources.Resource.Fulfillment</label>
                        <select asp-for="StatusUpdate.FulfillmentStatus" class="form-select">
                            @foreach (var fulfillmentStatus in Model.AvailableFulfillmentStatuses)
                            {
                                <option value="@fulfillmentStatus">@StorefrontStatusLocalizer.Localize(fulfillmentStatus)</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="StatusUpdate.Note" class="form-label">@Inventar.Resources.Resource.StatusNote</label>
                        <textarea asp-for="StatusUpdate.Note" class="form-control" rows="2" placeholder="@Inventar.Resources.Resource.OptionalNoteForTheStatusHistory"></textarea>
                    </div>

                    @if (canManageInternalNote)
                    {
                        <div class="col-12">
                            <label asp-for="StatusUpdate.InternalNote" class="form-label">@Inventar.Resources.Resource.InternalNote</label>
                            <textarea asp-for="StatusUpdate.InternalNote" class="form-control" rows="3" placeholder="@Inventar.Resources.Resource.VisibleOnlyToAdmins"></textarea>
                        </div>
                    }

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">@Inventar.Resources.Resource.SaveUpdate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h4 class="mb-0">@Inventar.Resources.Resource.OrderedItems</h4>
                    @if (Model.CanEditItems)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" id="enterOrderEditMode">
                            <i class="bi bi-pencil-square"></i> @Inventar.Resources.Resource.EditItems
                        </button>
                    }
                </div>

                <div id="orderItemsDisplaySection">
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>@Inventar.Resources.Resource.ProductNumber</th>
                                    <th>@Inventar.Resources.Resource.Name</th>
                                    <th>Model</th>
                                    <th>@Inventar.Resources.Resource.Color</th>
                                    <th>@Inventar.Resources.Resource.Size</th>
                                    <th>@Inventar.Resources.Resource.Price</th>
                                    <th>@Inventar.Resources.Resource.Quantity</th>
                                    <th>@Inventar.Resources.Resource.Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    var activeAllocations = poMjeriAllocationsByItemId.TryGetValue(item.Id, out var matchedAllocations)
                                        ? matchedAllocations
                                        : Array.Empty<Inventar.Models.InventoryReservation>();
                                    <tr>
                                        <td>
                                            @if (item.PoMjeri && activeAllocations.Count > 0)
                                            {
                                                foreach (var allocation in activeAllocations)
                                                {
                                                    <div class="fw-semibold">@($"{allocation.TepihId} x {allocation.Quantity}")</div>
                                                    <div class="small text-muted">@($"{allocation.Tepih?.Width}x{allocation.Tepih?.Length} / {allocation.Tepih?.UnID}")</div>
                                                }
                                            }
                                            else
                                            {
                                                @item.TepihId
                                            }
                                        </td>
                                        <td>@item.ProductNumber</td>
                                        <td>@item.ProductName</td>
                                        <td>@item.Model</td>
                                        <td>@item.Color</td>
                                        <td>@(item.Width.HasValue && item.Length.HasValue ? $"{item.Width}x{item.Length}" : "-")</td>
                                        <td>@($"{item.UnitPrice:0.00} EUR")</td>
                                        <td>@item.Quantity</td>
                                        <td>@($"{item.LineTotal:0.00} EUR")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="orderItemsEditSection" hidden>
                    <form id="orderItemEditTokenForm" class="d-none">
                        @Html.AntiForgeryToken()
                    </form>

                    <div class="alert alert-light border">
                        @Inventar.Resources.Resource.ItemsRemainInDraftModeUntilYouClickConfirm. @Inventar.Resources.Resource.QuantitiesAndCustomDimensionsAreRevalidatedBeforeSaving.
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <button type="button" class="btn btn-success btn-sm" id="openAddOrderItemModal">
                            <i class="bi bi-plus-lg"></i> @Inventar.Resources.Resource.AddProduct
                        </button>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="cancelOrderItemEdits">
                                @Inventar.Resources.Resource.Cancel
                            </button>
                            <button type="button" class="btn btn-primary btn-sm" id="saveOrderItemEdits">
                                @Inventar.Resources.Resource.ConfirmChanges
                            </button>
                        </div>
                    </div>

                    <div id="orderEditMessage" class="alert d-none"></div>

                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0" id="orderItemsEditTable">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>@Inventar.Resources.Resource.ProductNumber</th>
                                    <th>@Inventar.Resources.Resource.Name</th>
                                    <th>Model</th>
                                    <th>@Inventar.Resources.Resource.Color</th>
                                    <th>@Inventar.Resources.Resource.Size</th>
                                    <th>@Inventar.Resources.Resource.Price</th>
                                    <th>@Inventar.Resources.Resource.Quantity</th>
                                    <th>@Inventar.Resources.Resource.Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="orderItemsEditTableBody"></tbody>
                        </table>
                    </div>

                    <div class="border rounded p-3 mt-3 bg-light-subtle">
                        <div class="fw-semibold" id="orderEditItemsTotal"></div>
                        <div class="small text-muted" id="orderEditGrandTotal"></div>
                    </div>
                </div>

                @if (!Model.CanEditItems)
                {
                    <div class="alert alert-light border mt-3 mb-0">
                        @Inventar.Resources.Resource.ItemsCanOnlyBeEditedForActiveOrders.
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.PoMjeriItems.Count > 0)
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4>@Inventar.Resources.Resource.PerMeasureAllocations</h4>

                    @foreach (var poMjeriItem in Model.PoMjeriItems)
                    {
                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                                <div>
                                    <strong>@poMjeriItem.Item.ProductName</strong>
                                    <div class="text-muted small">
                                        @poMjeriItem.Item.ProductNumber | @poMjeriItem.Item.Model | @poMjeriItem.Item.Color | @poMjeriItem.Item.Width x @poMjeriItem.Item.Length
                                    </div>
                                </div>
                                <div class="small text-muted">
                                    @Inventar.Resources.Resource.Quantity: @poMjeriItem.Item.Quantity
                                </div>
                            </div>

                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>@Inventar.Resources.Resource.Source</th>
                                            <th>@Inventar.Resources.Resource.Quantity</th>
                                            <th>@Inventar.Resources.Resource.Cut</th> 
                                            <th>@Inventar.Resources.Resource.Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (poMjeriItem.ActiveReservations.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="4" class="text-muted">@Inventar.Resources.Resource.ThereAreNoActiveReservationsForThisItem.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var reservation in poMjeriItem.ActiveReservations)
                                            {
                                                <tr>
                                                    <td>@($"{reservation.Tepih?.Width}x{reservation.Tepih?.Length} / {reservation.Tepih?.UnID}")</td>
                                                    <td>@reservation.Quantity</td>
                                                    <td>@($"{reservation.CutWidth}x{reservation.CutLength}")</td>
                                                    <td>@StorefrontStatusLocalizer.Localize(reservation.Status)</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="alert alert-light border small">
                                @Inventar.Resources.Resource.CustomerGoal: <strong>@poMjeriItem.Item.Quantity x @poMjeriItem.Item.Width x @poMjeriItem.Item.Length</strong>.
                                @Inventar.Resources.Resource.ManuallyAllocateHowManyPiecesYouTakeFromEachAvailableInstance. @Inventar.Resources.Resource.TheSumMustBeExact @poMjeriItem.Item.Quantity.
                            </div>

                            @if (poMjeriItem.Candidates.Count == 0)
                            {
                                <div class="alert alert-warning mb-0">
                                    @Inventar.Resources.Resource.ThereAreCurrentlyNoOtherValidInstancesForThisPerMeasureAllocation.
                                </div>
                            }
                            else
                            {
                                <form asp-action="ReplacePoMjeriAllocation" asp-route-id="@Model.Order.Id" method="post" class="po-mjeri-allocation-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="WebOrderItemId" value="@poMjeriItem.Item.Id" />
                                    <input type="hidden" name="targetQuantity" value="@poMjeriItem.Item.Quantity" data-allocation-target />

                                    <div class="table-responsive mb-3">
                                        <table class="table table-sm table-bordered align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>@Inventar.Resources.Resource.Instance</th>
                                                    <th>@Inventar.Resources.Resource.OriginalSize</th> 
                                                    <th>@Inventar.Resources.Resource.RemainingSize</th>
                                                    <th>@Inventar.Resources.Resource.MaxPieces</th>
                                                    <th>@Inventar.Resources.Resource.Currently</th>
                                                    <th>@Inventar.Resources.Resource.NewQuantity</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (var index = 0; index < poMjeriItem.Candidates.Count; index++)
                                                {
                                                    var candidate = poMjeriItem.Candidates[index];
                                                    <tr>
                                                        <td>
                                                            <input type="hidden" name="Entries[@index].ProductId" value="@candidate.ProductId" />
                                                            <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(candidate.UnID) ? candidate.UnID : $"#{candidate.ProductId}")</div>
                                                            <div class="small text-muted">ID: @candidate.ProductId</div>
                                                        </td>
                                                        <td>@candidate.OriginalWidth x @candidate.OriginalLength</td>
                                                        <td>@candidate.RemainingWidth x @candidate.RemainingLength</td>
                                                        <td>@candidate.MaxAvailableQuantity</td>
                                                        <td>@candidate.CurrentAllocatedQuantity</td>
                                                        <td style="max-width: 120px;">
                                                            <input type="number"
                                                                   name="Entries[@index].Quantity"
                                                                   value="@candidate.CurrentAllocatedQuantity"
                                                                   min="0"
                                                                   max="@candidate.MaxAvailableQuantity"
                                                                   class="form-control form-control-sm text-end"
                                                                   data-allocation-quantity />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div class="small fw-semibold" data-allocation-summary></div>
                                        <button type="submit" class="btn btn-outline-primary" data-allocation-submit>@Inventar.Resources.Resource.ApplyAllocation</button>
                                    </div>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h4>@Inventar.Resources.Resource.Reservations</h4>
                @if (Model.Reservations.Count == 0)
                {
                    <div class="alert alert-light border mb-0">@Inventar.Resources.Resource.NoInventoryReservationsRecordedForThisOrderYet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>@Inventar.Resources.Resource.Product</th>
                                    <th>@Inventar.Resources.Resource.Quantity</th>
                                    <th>@Inventar.Resources.Resource.Size</th>
                                    <th>@Inventar.Resources.Resource.Status</th>
                                    <th>@Inventar.Resources.Resource.Created</th>
                                    <th>@Inventar.Resources.Resource.Expires</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model.Reservations)
                                {
                                    <tr>
                                        <td>@($"{reservation.TepihId}#{reservation.Tepih?.Name ?? "Product"}")</td>
                                        <td>@reservation.Quantity</td>
                                        <td>@(reservation.CutWidth.HasValue && reservation.CutLength.HasValue ? $"{reservation.CutWidth}x{reservation.CutLength}" : "-")</td>
                                        <td>@StorefrontStatusLocalizer.Localize(reservation.Status)</td>
                                        <td>@reservation.CreatedUtc.ToString("dd-MM-yyyy HH:mm")</td>
                                        <td>@(reservation.ExpiresUtc?.ToString("dd-MM-yyyy HH:mm") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h4>@Inventar.Resources.Resource.StatusHistory</h4>
                @if (Model.StatusHistory.Count == 0)
                {
                    <div class="alert alert-light border mb-0">@Inventar.Resources.Resource.NoStatusHistoryEntriesYet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>@Inventar.Resources.Resource.Changed</th>
                                    <th>@Inventar.Resources.Resource.Status</th>
                                    <th>@Inventar.Resources.Resource.By</th>
                                    <th>@Inventar.Resources.Resource.Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var history in Model.StatusHistory)
                                {
                                    <tr>
                                        <td>@history.ChangedUtc.ToString("dd-MM-yyyy HH:mm")</td>
                                        <td>@StorefrontStatusLocalizer.Localize(history.Status)</td>
                                        <td>@(history.ChangedBy ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(history.Note) ? "-" : StorefrontStatusLocalizer.LocalizeHistoryNote(history.Note))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm">@Inventar.Resources.Resource.BackToList</a>
</div>

<div id="addOrderItemModal" class="storefront-order-modal" hidden>
    <div class="storefront-order-modal__backdrop" data-close-add-order-item-modal></div>
    <div class="storefront-order-modal__panel storefront-order-modal__panel--wide">
        <button type="button" class="storefront-order-modal__close" data-close-add-order-item-modal aria-label="Close">x</button>
        <h5 class="mb-3">@Inventar.Resources.Resource.AddProductToOrder</h5>

        <div class="storefront-order-search-grid">
            <div>
                <input id="orderItemSearchName" type="text" class="form-control" placeholder="@Inventar.Resources.Resource.Name" />
            </div>
            <div>
                <input id="orderItemSearchModel" type="text" class="form-control" placeholder="Model" />
            </div>
            <div>
                <input id="orderItemSearchColor" type="text" class="form-control" placeholder="@Inventar.Resources.Resource.Color" />
            </div>
            <div>
                <input id="orderItemSearchSize" type="text" class="form-control" placeholder="@Inventar.Resources.Resource.Size" />
            </div>
        </div>

        <div class="mt-3" id="orderItemSearchResults"></div>
    </div>
</div>

<div id="orderPoMjeriModal" class="storefront-order-modal" hidden>
    <div class="storefront-order-modal__backdrop" data-close-order-po-mjeri-modal></div>
    <div class="storefront-order-modal__panel">
        <button type="button" class="storefront-order-modal__close" data-close-order-po-mjeri-modal aria-label="Close">x</button>
        <h5 class="mb-3">@Inventar.Resources.Resource.AddPerMeasureProduct</h5>

        <div class="storefront-order-meta">
            <div><strong>@Inventar.Resources.Resource.OriginalSize:</strong> <span id="orderPoMjeriOriginalSize"></span></div>
            <div><strong>@Inventar.Resources.Resource.RemainingSize:</strong> <span id="orderPoMjeriRemainingSize"></span></div> 
            <div><strong>UnID:</strong> <span id="orderPoMjeriUnId"></span></div>
        </div>

        <div class="storefront-order-search-grid">
            <div>
                <label for="orderPoMjeriWidth" class="form-label">@Inventar.Resources.Resource.Width</label>
                <input id="orderPoMjeriWidth" type="number" min="1" class="form-control" readonly />
            </div>
            <div>
                <label for="orderPoMjeriLength" class="form-label">@Inventar.Resources.Resource.Length</label>
                <input id="orderPoMjeriLength" type="number" min="1" class="form-control" />
            </div>
            <div>
                <label for="orderPoMjeriQuantity" class="form-label">@Inventar.Resources.Resource.Quantity</label>
                <input id="orderPoMjeriQuantity" type="number" min="1" class="form-control" value="1" />
            </div>
        </div>

        <div class="storefront-order-meta mt-3">
            <div><strong>@Inventar.Resources.Resource.MaxAvailableQuantity:</strong> <span id="orderPoMjeriMaxQuantity">0</span></div>
        </div>

        <div id="orderPoMjeriValidation" class="small text-danger mt-2" style="min-height:1.25rem;"></div>

        <div class="d-flex justify-content-end mt-3">
            <button type="button" class="btn btn-primary" id="confirmAddOrderPoMjeri">@Inventar.Resources.Resource.AddProduct</button>
        </div>
    </div>
</div>

<style>
    .storefront-order-modal[hidden] {
        display: none !important;
    }

    .storefront-order-modal {
        position: fixed;
        inset: 0;
        z-index: 1200;
    }

    .storefront-order-modal__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
    }

    .storefront-order-modal__panel {
        position: relative;
        z-index: 1;
        max-width: 560px;
        margin: 6vh auto 0;
        background: #fff;
        border-radius: 16px;
        padding: 1.25rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    }

    .storefront-order-modal__panel--wide {
        max-width: 760px;
    }

    .storefront-order-modal__close {
        position: absolute;
        top: 0.6rem;
        right: 0.8rem;
        border: 0;
        background: transparent;
        font-size: 1.6rem;
        line-height: 1;
    }

    .storefront-order-search-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem 1rem;
    }

    .storefront-order-meta {
        display: grid;
        gap: 0.4rem;
    }

    .storefront-order-quantity-stepper {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: nowrap;
    }

    .storefront-order-quantity-stepper .form-control {
        width: 4.5rem;
        text-align: center;
    }

    .storefront-order-draft-note {
        font-size: 0.85rem;
        color: #6c757d;
    }

    @@media (max-width: 767.98px) {
        .storefront-order-search-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

<script>
    (() => {
        const orderId = @Model.Order.Id;
        const shippingTotal = @Model.Order.ShippingTotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const discountTotal = @Model.Order.DiscountTotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const initialItems = @Html.Raw(editableItemsJson);
        const canEditItems = @Model.CanEditItems.ToString().ToLowerInvariant();
        const tokenField = document.querySelector('#orderItemEditTokenForm input[name="__RequestVerificationToken"]');
        const antiForgeryToken = tokenField ? tokenField.value : '';

        const displaySection = document.getElementById('orderItemsDisplaySection');
        const editSection = document.getElementById('orderItemsEditSection');
        const enterEditButton = document.getElementById('enterOrderEditMode');
        const cancelEditButton = document.getElementById('cancelOrderItemEdits');
        const saveEditButton = document.getElementById('saveOrderItemEdits');
        const editTableBody = document.getElementById('orderItemsEditTableBody');
        const editMessage = document.getElementById('orderEditMessage');
        const itemsTotalEl = document.getElementById('orderEditItemsTotal');
        const grandTotalEl = document.getElementById('orderEditGrandTotal');

        const addModal = document.getElementById('addOrderItemModal');
        const openAddModalButton = document.getElementById('openAddOrderItemModal');
        const searchInputs = {
            name: document.getElementById('orderItemSearchName'),
            model: document.getElementById('orderItemSearchModel'),
            color: document.getElementById('orderItemSearchColor'),
            size: document.getElementById('orderItemSearchSize')
        };
        const searchResults = document.getElementById('orderItemSearchResults');

        const poMjeriModal = document.getElementById('orderPoMjeriModal');
        const poMjeriOriginalSize = document.getElementById('orderPoMjeriOriginalSize');
        const poMjeriRemainingSize = document.getElementById('orderPoMjeriRemainingSize');
        const poMjeriUnId = document.getElementById('orderPoMjeriUnId');
        const poMjeriWidthInput = document.getElementById('orderPoMjeriWidth');
        const poMjeriLengthInput = document.getElementById('orderPoMjeriLength');
        const poMjeriQuantityInput = document.getElementById('orderPoMjeriQuantity');
        const poMjeriMaxQuantity = document.getElementById('orderPoMjeriMaxQuantity');
        const poMjeriValidation = document.getElementById('orderPoMjeriValidation');
        const confirmAddPoMjeriButton = document.getElementById('confirmAddOrderPoMjeri');

        let draftItems = [];
        let nextDraftKey = 1;
        let searchResultCache = [];
        let selectedPoMjeriProduct = null;
        let latestPoMjeriPreview = null;
        const poMjeriPreviewTimers = new Map();

        function deepClone(value) {
            return JSON.parse(JSON.stringify(value));
        }

        function toNumber(value, fallback = 0) {
            const parsed = Number.parseFloat(value);
            return Number.isFinite(parsed) ? parsed : fallback;
        }

        function toInt(value, fallback = 0) {
            const parsed = Number.parseInt(value, 10);
            return Number.isFinite(parsed) ? parsed : fallback;
        }

        function formatMoney(value) {
            return `${toNumber(value, 0).toFixed(2)} EUR`;
        }

        function formatSize(width, length) {
            return width && length ? `${width}x${length}` : '-';
        }

        function calculatePerM2UnitPrice(rate, width, length) {
            const normalizedWidth = toInt(width, 0);
            const normalizedLength = toInt(length, 0);
            if (normalizedWidth <= 0 || normalizedLength <= 0) {
                return toNumber(rate, 0);
            }

            return Number((toNumber(rate, 0) * ((normalizedWidth * normalizedLength) / 10000)).toFixed(2));
        }

        function calculatePoMjeriUnitPrice(rate, length) {
            const normalizedLength = Math.max(toInt(length, 0), 100);
            return Number((toNumber(rate, 0) * (normalizedLength / 100)).toFixed(2));
        }

        function buildClientItem(source) {
            return {
                DraftKey: `draft-${nextDraftKey++}`,
                ExistingItemId: source.ExistingItemId ?? null,
                ProductId: source.ProductId,
                ProductNumber: source.ProductNumber ?? '',
                ProductName: source.ProductName ?? '',
                Model: source.Model ?? '',
                Color: source.Color ?? '',
                Width: source.Width ?? null,
                Length: source.Length ?? null,
                PerM2: Boolean(source.PerM2),
                PoMjeri: Boolean(source.PoMjeri),
                Quantity: toInt(source.Quantity, 1),
                MaxQuantity: Math.max(toInt(source.MaxQuantity, 1), toInt(source.Quantity, 1)),
                MaxQuantityMessage: source.MaxQuantityMessage ?? '',
                UnitPrice: toNumber(source.UnitPrice, 0),
                LineTotal: toNumber(source.LineTotal, 0),
                PrimaryImageUrl: source.PrimaryImageUrl ?? null
            };
        }

        function resetDraftItems() {
            nextDraftKey = 1;
            draftItems = initialItems.map(buildClientItem);
        }

        function setEditMessage(message, tone) {
            if (!editMessage) {
                return;
            }

            if (!message) {
                editMessage.className = 'alert d-none';
                editMessage.textContent = '';
                return;
            }

            const toneClass = tone === 'success'
                ? 'alert-success'
                : tone === 'warning'
                    ? 'alert-warning'
                    : 'alert-danger';

            editMessage.className = `alert ${toneClass}`;
            editMessage.textContent = message;
        }

        function updateDraftTotals() {
            const itemsTotal = draftItems.reduce((sum, item) => sum + toNumber(item.LineTotal, 0), 0);
            const grandTotal = itemsTotal + toNumber(shippingTotal, 0) - toNumber(discountTotal, 0);

            if (itemsTotalEl) {
                itemsTotalEl.textContent = `@Inventar.Resources.Resource.TotalItems: ${formatMoney(itemsTotal)}`;
            }

            if (grandTotalEl) {
                grandTotalEl.textContent = `@Inventar.Resources.Resource.TotalOrderAmount: ${formatMoney(grandTotal)}`;
            }
        }

        function renderEditTable() {
            if (!editTableBody) {
                return;
            }

            if (draftItems.length === 0) {
                editTableBody.innerHTML = `
                    <tr>
                                <td colspan="10" class="text-center text-muted">@Inventar.Resources.Resource.AnOrderMustHaveAtLeastOneItem. @Inventar.Resources.Resource.AddNewProductOrCancelTheChanges.</td>
                    </tr>`;
                updateDraftTotals();
                return;
            }

            editTableBody.innerHTML = draftItems.map(item => {
                return `
                    <tr data-draft-key="${item.DraftKey}">
                        <td>${item.ProductId}</td>
                        <td>${item.ProductNumber}</td>
                        <td>
                            <div class="fw-semibold">${item.ProductName}</div>
                                ${item.PoMjeri ? '<div class="storefront-order-draft-note">@Inventar.Resources.Resource.PerMeasure</div>' : ''}
                        </td>
                        <td>${item.Model || '-'}</td>
                        <td>${item.Color || '-'}</td>
                        <td>${formatSize(item.Width, item.Length)}</td>
                        <td>${formatMoney(item.UnitPrice)}</td>
                        <td>
                            <div class="storefront-order-quantity-stepper">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-quantity-action="decrease" data-draft-key="${item.DraftKey}">-</button>
                                <input type="number"
                                       class="form-control form-control-sm"
                                       min="1"
                                       max="${item.MaxQuantity || 1}"
                                       value="${item.Quantity}"
                                       data-quantity-input="${item.DraftKey}" />
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-quantity-action="increase" data-draft-key="${item.DraftKey}">+</button>
                            </div>
                            <div class="storefront-order-draft-note">${item.MaxQuantityMessage || ''}</div>
                        </td>
                        <td>${formatMoney(item.LineTotal)}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm" data-remove-item="${item.DraftKey}" aria-label="@Inventar.Resources.Resource.DeleteItem">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>`;
            }).join('');

            updateDraftTotals();
        }

        function recalculateLineTotal(item) {
            item.LineTotal = Number((toNumber(item.UnitPrice, 0) * toInt(item.Quantity, 1)).toFixed(2));
        }

        function findDraftItem(draftKey) {
            return draftItems.find(item => item.DraftKey === draftKey);
        }

        function clampRegularItemQuantity(item, requestedQuantity) {
            const normalizedQuantity = Math.max(1, requestedQuantity);
            if (normalizedQuantity > item.MaxQuantity) {
                item.Quantity = item.MaxQuantity;
                recalculateLineTotal(item);
                setEditMessage(item.MaxQuantityMessage || `@Inventar.Resources.Resource.ItIsPossibleToOrderMaximumOf ${item.MaxQuantity} @Inventar.Resources.Resource.pieces.`, 'warning');
                return;
            }

            item.Quantity = normalizedQuantity;
            recalculateLineTotal(item);
            setEditMessage('', '');
        }

        async function refreshPoMjeriLinePreview(item, requestedQuantity) {
            const response = await fetch(`@Url.Action("PreviewPoMjeriSelection", "StorefrontOrder", new { id = Model.Order.Id })`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiForgeryToken
                },
                body: JSON.stringify({
                    productId: item.ProductId,
                    customWidth: item.Width,
                    customLength: item.Length,
                    quantity: requestedQuantity
                })
            });

            return await response.json();
        }

        function updatePoMjeriLineQuantity(item, requestedQuantity) {
            const normalizedQuantity = Math.max(1, requestedQuantity);
            item.Quantity = normalizedQuantity;
            recalculateLineTotal(item);
            renderEditTable();

            clearTimeout(poMjeriPreviewTimers.get(item.DraftKey));
            poMjeriPreviewTimers.set(item.DraftKey, setTimeout(async () => {
                try {
                    const result = await refreshPoMjeriLinePreview(item, item.Quantity);
                    item.MaxQuantity = Math.max(1, toInt(result.maxAvailableQuantity, item.MaxQuantity));
                    item.MaxQuantityMessage = result.message || '';

                    if (!result.success) {
                        if (item.Quantity > item.MaxQuantity) {
                            item.Quantity = item.MaxQuantity;
                            recalculateLineTotal(item);
                        }

                        renderEditTable();
                        setEditMessage(result.message || '@Inventar.Resources.Resource.PMquantityUpdateFailed.', 'warning');
                        return;
                    }

                    if (item.Quantity > item.MaxQuantity) {
                        item.Quantity = item.MaxQuantity;
                        recalculateLineTotal(item);
                        setEditMessage(result.message || `@Inventar.Resources.Resource.ItIsPossibleToOrderMaximumOf ${item.MaxQuantity} @Inventar.Resources.Resource.pieces.`, 'warning');
                    } else {
                        setEditMessage('', '');
                    }

                    renderEditTable();
                } catch (error) {
                    console.error(error);
                    setEditMessage('@Inventar.Resources.Resource.PMamountCheckFailed. @Inventar.Resources.Resource.TryAgain.', 'warning');
                }
            }, 250));
        }

        function changeItemQuantity(draftKey, delta) {
            const item = findDraftItem(draftKey);
            if (!item) {
                return;
            }

            const requestedQuantity = Math.max(1, toInt(item.Quantity, 1) + delta);
            if (!item.PoMjeri) {
                clampRegularItemQuantity(item, requestedQuantity);
                renderEditTable();
                return;
            }

            updatePoMjeriLineQuantity(item, requestedQuantity);
        }

        function handleQuantityInput(draftKey, rawValue) {
            const item = findDraftItem(draftKey);
            if (!item) {
                return;
            }

            const requestedQuantity = Math.max(1, toInt(rawValue, 1));
            if (!item.PoMjeri) {
                clampRegularItemQuantity(item, requestedQuantity);
                renderEditTable();
                return;
            }

            updatePoMjeriLineQuantity(item, requestedQuantity);
        }

        function removeDraftItem(draftKey) {
            draftItems = draftItems.filter(item => item.DraftKey !== draftKey);
            setEditMessage('', '');
            renderEditTable();
        }

        function enterEditMode() {
            if (!displaySection || !editSection) {
                return;
            }

            resetDraftItems();
            setEditMessage('', '');
            renderEditTable();
            displaySection.hidden = true;
            editSection.hidden = false;
            if (enterEditButton) {
                enterEditButton.hidden = true;
            }
        }

        function leaveEditMode() {
            if (!displaySection || !editSection) {
                return;
            }

            setEditMessage('', '');
            displaySection.hidden = false;
            editSection.hidden = true;
            if (enterEditButton && canEditItems) {
                enterEditButton.hidden = false;
            }

            closeAddModal();
            closePoMjeriModal();
        }

        function openAddModal() {
            if (!addModal) {
                return;
            }

            addModal.hidden = false;
            searchInputs.name?.focus();
        }

        function closeAddModal() {
            if (!addModal) {
                return;
            }

            addModal.hidden = true;
        }

        function openPoMjeriModal(result) {
            selectedPoMjeriProduct = result;
            latestPoMjeriPreview = null;
            poMjeriOriginalSize.textContent = formatSize(result.width, result.length);
            poMjeriRemainingSize.textContent = formatSize(result.remainingWidth, result.remainingLength);
            poMjeriUnId.textContent = result.unId || '-';
            poMjeriWidthInput.value = result.width || '';
            poMjeriLengthInput.value = '';
            poMjeriQuantityInput.value = '1';
            poMjeriMaxQuantity.textContent = '0';
            poMjeriValidation.textContent = '';
            poMjeriModal.hidden = false;
            poMjeriLengthInput.focus();
        }

        function closePoMjeriModal() {
            selectedPoMjeriProduct = null;
            latestPoMjeriPreview = null;
            poMjeriModal.hidden = true;
            poMjeriWidthInput.value = '';
            poMjeriValidation.textContent = '';
        }

        async function searchProducts() {
            const params = new URLSearchParams({
                id: String(orderId),
                name: searchInputs.name?.value || '',
                model: searchInputs.model?.value || '',
                color: searchInputs.color?.value || '',
                size: searchInputs.size?.value || ''
            });

            const allEmpty = Array.from(params.values()).slice(1).every(value => !value.trim());
            if (allEmpty) {
                searchResults.innerHTML = '';
                searchResultCache = [];
                return;
            }

            try {
                const response = await fetch(`@Url.Action("SearchProducts", "StorefrontOrder")?${params.toString()}`);
                const result = await response.json();
                searchResultCache = Array.isArray(result) ? result : [];

                if (searchResultCache.length === 0) {
                    searchResults.innerHTML = '<div class="text-muted">@Inventar.Resources.Resource.NoResultsFound</div>';
                    return;
                }

                const html = searchResultCache.map(item => {
                    const sizeText = item.width && item.length ? ` - ${item.width}x${item.length}` : '';
                    const poMjeriText = item.poMjeri && item.unId
                        ? ` - ${item.remainingWidth}x${item.remainingLength} / ${item.unId}`
                        : '';

                    return `
                        <button type="button"
                                class="list-group-item list-group-item-action order-item-search-result"
                                data-product-id="${item.id}">
                            <strong>${item.productNumber}</strong> - ${item.name} - ${item.model || '-'} - ${item.color || '-'}${sizeText}${poMjeriText}
                        </button>`;
                }).join('');

                searchResults.innerHTML = `<div class="list-group">${html}</div>`;
            } catch (error) {
                console.error(error);
                searchResults.innerHTML = '<div class="text-danger">@Inventar.Resources.Resource.ProductSearchFailed.</div>';
            }
        }

        function addRegularDraftItem(result) {
            const matchingItem = draftItems.find(item => !item.PoMjeri && item.ProductId === result.id);
            const maxQuantity = Math.max(1, toInt(result.maxQuantity, 1));
            const unitPrice = result.perM2
                ? calculatePerM2UnitPrice(result.effectivePrice, result.width, result.length)
                : toNumber(result.effectivePrice, 0);

            if (matchingItem) {
                if (matchingItem.Quantity >= maxQuantity) {
                    setEditMessage(`@Inventar.Resources.Resource.ItIsPossibleToOrderMaximumOf ${maxQuantity} @Inventar.Resources.Resource.PiecesForGivenProduct.`, 'warning');
                    return;
                }

                matchingItem.MaxQuantity = maxQuantity;
                matchingItem.MaxQuantityMessage = `@Inventar.Resources.Resource.ItIsPossibleToOrderMaximumOf ${maxQuantity} @Inventar.Resources.Resource.pieces.`;
                matchingItem.UnitPrice = unitPrice;
                matchingItem.Quantity += 1;
                recalculateLineTotal(matchingItem);
                renderEditTable();
                setEditMessage('@Inventar.Resources.Resource.TheProductHasBeenAddedToTheDraftChanges.', 'success');
                closeAddModal();
                return;
            }

            draftItems.push(buildClientItem({
                ExistingItemId: null,
                ProductId: result.id,
                ProductNumber: result.productNumber,
                ProductName: result.name,
                Model: result.model,
                Color: result.color,
                Width: result.width,
                Length: result.length,
                PerM2: Boolean(result.perM2),
                PoMjeri: false,
                Quantity: 1,
                MaxQuantity: maxQuantity,
                MaxQuantityMessage: `@Inventar.Resources.Resource.ItIsPossibleToOrderMaximumOf ${maxQuantity} @Inventar.Resources.Resource.pieces.`,
                UnitPrice: unitPrice,
                LineTotal: unitPrice
            }));

            renderEditTable();
            setEditMessage('@Inventar.Resources.Resource.TheProductHasBeenAddedToTheDraftChanges.', 'success');
            closeAddModal();
        }

        async function previewSelectedPoMjeri() {
            if (!selectedPoMjeriProduct) {
                latestPoMjeriPreview = null;
                poMjeriMaxQuantity.textContent = '0';
                poMjeriValidation.textContent = '';
                return false;
            }

            const customWidth = selectedPoMjeriProduct?.width ? toInt(selectedPoMjeriProduct.width, 0) : 0;
            const customLength = toInt(poMjeriLengthInput.value, 0);
            const quantity = Math.max(1, toInt(poMjeriQuantityInput.value, 1));

            if (customWidth < 1 || customLength < 1) {
                latestPoMjeriPreview = null;
                poMjeriMaxQuantity.textContent = '0';
                poMjeriValidation.textContent = '';
                return false;
            }

            try {
                const response = await fetch(`@Url.Action("PreviewPoMjeriSelection", "StorefrontOrder", new { id = Model.Order.Id })`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({
                        productId: selectedPoMjeriProduct.id,
                        customWidth: customWidth,
                        customLength: customLength,
                        quantity: quantity
                    })
                });

                const result = await response.json();
                latestPoMjeriPreview = result;
                poMjeriMaxQuantity.textContent = String(result.maxAvailableQuantity || 0);
                poMjeriValidation.textContent = result.message || '';

                if (!result.success && result.maxAvailableQuantity > 0 && quantity > result.maxAvailableQuantity) {
                    poMjeriQuantityInput.value = String(result.maxAvailableQuantity);
                }

                return Boolean(result.success);
            } catch (error) {
                console.error(error);
                latestPoMjeriPreview = null;
                poMjeriMaxQuantity.textContent = '0';
                poMjeriValidation.textContent = '@Inventar.Resources.Resource.PMproductVerificationFailed.';
                return false;
            }
        }

        function addPoMjeriDraftItem() {
            if (!selectedPoMjeriProduct || !latestPoMjeriPreview || !latestPoMjeriPreview.success) {
                poMjeriValidation.textContent = latestPoMjeriPreview?.message || '@Inventar.Resources.Resource.FirstEnterTheCorrectDimensions.';
                return;
            }

            const customWidth = selectedPoMjeriProduct?.width ? toInt(selectedPoMjeriProduct.width, 0) : 0;
            const customLength = toInt(poMjeriLengthInput.value, 0);
            const quantity = Math.max(1, toInt(poMjeriQuantityInput.value, 1));
            const maxQuantity = Math.max(1, toInt(latestPoMjeriPreview.maxAvailableQuantity, 1));

            if (quantity > maxQuantity) {
                poMjeriValidation.textContent = latestPoMjeriPreview.message || `@Inventar.Resources.Resource.ItIsPossibleToOrderMaximumOf ${maxQuantity} @Inventar.Resources.Resource.pieces.`;
                poMjeriQuantityInput.value = String(maxQuantity);
                return;
            }

            const matchingItem = draftItems.find(item =>
                item.PoMjeri &&
                item.ProductId === selectedPoMjeriProduct.id &&
                item.Color === selectedPoMjeriProduct.color &&
                item.Width === customWidth &&
                item.Length === customLength);

            const unitPrice = calculatePoMjeriUnitPrice(selectedPoMjeriProduct.effectivePrice, customLength);

            if (matchingItem) {
                const newQuantity = matchingItem.Quantity + quantity;
                if (newQuantity > maxQuantity) {
                    poMjeriValidation.textContent = latestPoMjeriPreview.message || `@Inventar.Resources.Resource.ItIsPossibleToOrderMaximumOf ${maxQuantity} @Inventar.Resources.Resource.pieces.`;
                    return;
                }

                matchingItem.Quantity = newQuantity;
                matchingItem.MaxQuantity = maxQuantity;
                matchingItem.MaxQuantityMessage = latestPoMjeriPreview.message || '';
                matchingItem.UnitPrice = unitPrice;
                recalculateLineTotal(matchingItem);
            } else {
                draftItems.push(buildClientItem({
                    ExistingItemId: null,
                    ProductId: selectedPoMjeriProduct.id,
                    ProductNumber: selectedPoMjeriProduct.productNumber,
                    ProductName: selectedPoMjeriProduct.name,
                    Model: selectedPoMjeriProduct.model,
                    Color: selectedPoMjeriProduct.color,
                    Width: customWidth,
                    Length: customLength,
                    PerM2: true,
                    PoMjeri: true,
                    Quantity: quantity,
                    MaxQuantity: maxQuantity,
                    MaxQuantityMessage: latestPoMjeriPreview.message || '',
                    UnitPrice: unitPrice,
                    LineTotal: unitPrice * quantity
                }));
            }

            renderEditTable();
            setEditMessage('PM @Inventar.Resources.Resource.TheProductHasBeenAddedToTheDraftChanges.', 'success');
            closePoMjeriModal();
            closeAddModal();
        }

        async function saveDraftEdits() {
            if (draftItems.length === 0) {
                setEditMessage('@Inventar.Resources.Resource.AnOrderMustHaveAtLeastOneItem.', 'warning');
                return;
            }

            saveEditButton.disabled = true;

            try {
                const payload = {
                    webOrderId: orderId,
                    items: draftItems.map(item => ({
                        existingItemId: item.ExistingItemId,
                        productId: item.ProductId,
                        quantity: item.Quantity,
                        poMjeri: item.PoMjeri,
                        perM2: item.PerM2,
                        color: item.Color,
                        width: item.Width,
                        length: item.Length
                    }))
                };

                const response = await fetch(`@Url.Action("SaveItems", "StorefrontOrder", new { id = Model.Order.Id })`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    setEditMessage(result.message || '@Inventar.Resources.Resource.FailedToUpdateItems.', 'warning');
                    return;
                }

                window.location.reload();
            } catch (error) {
                console.error(error);
                setEditMessage('@Inventar.Resources.Resource.FailedToUpdateItems.', 'danger');
            } finally {
                saveEditButton.disabled = false;
            }
        }

        document.querySelectorAll('.po-mjeri-allocation-form').forEach((form) => {
            const inputs = Array.from(form.querySelectorAll('[data-allocation-quantity]'));
            const targetField = form.querySelector('[data-allocation-target]');
            const summary = form.querySelector('[data-allocation-summary]');
            const submitButton = form.querySelector('[data-allocation-submit]');
            const targetQuantity = Number.parseInt(targetField?.value ?? '0', 10) || 0;

            const refreshState = () => {
                let selectedTotal = 0;

                inputs.forEach((input) => {
                    const max = Number.parseInt(input.getAttribute('max') ?? '0', 10) || 0;
                    let value = Number.parseInt(input.value ?? '0', 10);

                    if (Number.isNaN(value) || value < 0) {
                        value = 0;
                    }

                    if (value > max) {
                        value = max;
                    }

                    input.value = value.toString();
                    selectedTotal += value;
                });

                const difference = targetQuantity - selectedTotal;
                if (!summary) {
                    return;
                }

                if (difference === 0) {
                    summary.textContent = `Odabrano ${selectedTotal} / ${targetQuantity}. @Inventar.Resources.Resource.TheAllocationIsReadyToSave.`;
                    summary.className = 'small fw-semibold text-success';
                } else if (difference > 0) {
                    summary.textContent = `Odabrano ${selectedTotal} / ${targetQuantity}. @Inventar.Resources.Resource.ItIsNecessaryToAdd ${difference} @Inventar.Resources.Resource.more.`;
                    summary.className = 'small fw-semibold text-warning';
                } else {
                    summary.textContent = `Odabrano ${selectedTotal} / ${targetQuantity}. @Inventar.Resources.Resource.ItIsNecessaryToReduceBy ${Math.abs(difference)}.`;
                    summary.className = 'small fw-semibold text-danger';
                }

                if (submitButton) {
                    submitButton.disabled = difference !== 0;
                }
            };

            inputs.forEach((input) => {
                input.addEventListener('input', refreshState);
                input.addEventListener('change', refreshState);
            });

            refreshState();
        });

        if (canEditItems) {
            resetDraftItems();

            enterEditButton?.addEventListener('click', enterEditMode);
            cancelEditButton?.addEventListener('click', leaveEditMode);
            saveEditButton?.addEventListener('click', saveDraftEdits);
            openAddModalButton?.addEventListener('click', openAddModal);

            document.querySelectorAll('[data-close-add-order-item-modal]').forEach((element) => {
                element.addEventListener('click', closeAddModal);
            });

            document.querySelectorAll('[data-close-order-po-mjeri-modal]').forEach((element) => {
                element.addEventListener('click', closePoMjeriModal);
            });

            Object.values(searchInputs).forEach((input) => {
                input?.addEventListener('input', searchProducts);
            });

            document.addEventListener('click', (event) => {
                const searchButton = event.target.closest('.order-item-search-result');
                if (searchButton) {
                    const productId = toInt(searchButton.getAttribute('data-product-id'), 0);
                    const result = searchResultCache.find(item => item.id === productId);
                    if (!result) {
                        return;
                    }

                    if (result.poMjeri) {
                        openPoMjeriModal(result);
                        return;
                    }

                    addRegularDraftItem(result);
                    return;
                }

                const quantityButton = event.target.closest('[data-quantity-action]');
                if (quantityButton) {
                    const draftKey = quantityButton.getAttribute('data-draft-key');
                    const delta = quantityButton.getAttribute('data-quantity-action') === 'increase' ? 1 : -1;
                    changeItemQuantity(draftKey, delta);
                    return;
                }

                const removeButton = event.target.closest('[data-remove-item]');
                if (removeButton) {
                    removeDraftItem(removeButton.getAttribute('data-remove-item'));
                }
            });

            document.addEventListener('input', (event) => {
                const quantityInput = event.target.closest('[data-quantity-input]');
                if (quantityInput) {
                    handleQuantityInput(quantityInput.getAttribute('data-quantity-input'), quantityInput.value);
                }
            });

            [poMjeriLengthInput, poMjeriQuantityInput].forEach((input) => {
                input?.addEventListener('input', () => {
                    clearTimeout(input._previewTimer);
                    input._previewTimer = setTimeout(previewSelectedPoMjeri, 250);
                });
            });

            confirmAddPoMjeriButton?.addEventListener('click', addPoMjeriDraftItem);
        }
    })();
</script>
